<UserControl
    x:Class="GearDeck.Desktop.Views.MacrosView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto">
        <Panel Margin="24,18,24,28">

            <!-- 一级页面：宏预设库列表 -->
            <StackPanel x:Name="MacroListView" Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="鼠标宏中心" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Classes="meta" Text="点击「新建宏」或卡片中的「编辑」进入二级录制与步骤编排界面" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="NewMacroBtn" Content="+ 新建宏" Classes="accent" Margin="0,0,8,4" />
                        <Button x:Name="ImportBtn" Content="导入 JSON" Classes="tool" Margin="0,0,8,4" />
                        <Button x:Name="ExportBtn" Content="导出 JSON" Classes="tool" Margin="0,0,14,4" />
                        <ToggleSwitch x:Name="GlobalEnableSwitch" MinWidth="0" VerticalAlignment="Center"
                                      OnContent="侧键接管已开启" OffContent="侧键接管已关闭" Margin="0,0,0,4" />
                    </WrapPanel>
                </Grid>

                <Border x:Name="AdminBanner" IsVisible="False"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="当前以普通用户权限运行（UIPI 限制）" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Classes="meta" Text="若需在管理员权限运行的游戏或全屏程序中触发软件侧键宏，请使用管理员权限重启 GearDeck。" />
                        </StackPanel>
                        <Button x:Name="RestartAdminBtn" Grid.Column="1" Content="以管理员重启"
                                Classes="tool" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border x:Name="MacOsBanner" IsVisible="False"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="macOS：辅助功能与宏配置说明" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="MacOsNoticeText" Classes="meta" />
                        </StackPanel>
                        <Button x:Name="OpenMacAccessibilityBtn" Grid.Column="1" Content="打开辅助功能设置"
                                Classes="tool" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border x:Name="SoftwareMacroRiskBanner"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="软件宏风险提示与全局关闭说明" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Classes="meta"
                                   Text="风险提示：软件宏通过系统级键鼠钩子监听并模拟输入（SendInput），竞技类反作弊系统（如 Vanguard、EAC、BattlEye、ACE 等）可能会判定为第三方自动化行为并拦截或处罚，建议仅在单机、办公或非竞技场景下使用。&#10;全局关闭方法：关闭右上角「侧键接管」总开关，将立即卸载后台全局钩子并恢复鼠标所有原生按键功能；如需移除单设备侧键绑定，也可在对应设备详情页点击「解绑」或彻底退出 GearDeck。" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="GlobalStateText" Classes="meta" />
                        <ProgressBar x:Name="ListPlaybackBar" Maximum="1" Minimum="0" Height="3" IsVisible="False" />
                    </StackPanel>
                </Border>

                <Panel x:Name="MacroLibraryHost" />
            </StackPanel>

            <!-- 二级页面：宏新建 / 编辑工作区 -->
            <StackPanel x:Name="MacroEditorView" Spacing="14" IsVisible="False">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="BackToListBtn" Grid.Column="0" Content="← 返回宏列表"
                                Classes="tool" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="EditorTitleText" Text="编辑宏" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="EditorSubText" Classes="meta" Text="所有修改仅在点击「保存并返回」后写入宏库" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button x:Name="CancelEditBtn" Content="取消" Classes="tool" />
                            <Button x:Name="SaveMacroBtn" Content="保存并返回" Classes="accent" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 1：基础属性 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <Grid ColumnDefinitions="1.3*,1.1*,0.9*">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="label" Text="宏名称" />
                            <TextBox x:Name="MacroNameBox" Watermark="例如：一键切雷 / 快速连点" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" Margin="0,0,12,0">
                            <TextBlock Classes="label" Text="触发方式" />
                            <ComboBox x:Name="MacroLoopCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="PlayOnce" Content="单次（按下播放 1 次）" />
                                <ComboBoxItem Tag="WhileHeld" Content="按住循环（松开即停）" />
                                <ComboBoxItem Tag="ToggleUntilKey" Content="切换（再按或 Esc 停止）" />
                                <ComboBoxItem Tag="RepeatCount" Content="指定次数（循环 N 次）" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Classes="label" Text="重复次数 (1~99)" />
                            <ui:NumberBox x:Name="MacroRepeatBox" Maximum="99" Minimum="1" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 卡片 2：动作录制与步骤编排 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="录制与动作步骤" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ToggleButton x:Name="RecordMacroBtn" Content="开始录制键鼠动作" Padding="12,6" FontSize="12" />
                                <Button x:Name="ClearStepsBtn" Content="清空步骤" Classes="tool" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="RecordCaptureBanner" IsVisible="False" Focusable="True"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                BorderThickness="1.5" CornerRadius="8" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="录制进行中" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="RecordStatusText" Classes="meta" />
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <ComboBox x:Name="ManualKeyCombo" Width="170" Margin="0,0,8,6" VerticalAlignment="Center" />
                            <Button x:Name="AddKeyPressBtn" Content="+ 按下" Classes="tool" Margin="0,0,6,6" />
                            <Button x:Name="AddKeyReleaseBtn" Content="+ 抬起" Classes="tool" Margin="0,0,10,6" />
                            <Button x:Name="AddLeftClickBtn" Content="+ 左键点击" Classes="tool" Margin="0,0,6,6" />
                            <Button x:Name="AddRightClickBtn" Content="+ 右键点击" Classes="tool" Margin="0,0,6,6" />
                            <Button x:Name="AddMiddleClickBtn" Content="+ 中键点击" Classes="tool" Margin="0,0,6,6" />
                            <Button x:Name="AddWheelUpBtn" Content="+ 滚轮上" Classes="tool" Margin="0,0,6,6" />
                            <Button x:Name="AddWheelDownBtn" Content="+ 滚轮下" Classes="tool" Margin="0,0,10,6" />
                            <TextBlock Classes="label" Text="默认间隔 (ms)" VerticalAlignment="Center" Margin="0,0,6,6" />
                            <ui:NumberBox x:Name="StepDelayBox" Width="106" Maximum="5000" Minimum="5" Margin="0,0,6,6" VerticalAlignment="Center" />
                            <Button x:Name="AddDelayBtn" Content="+ 添加间隔" Classes="tool" Margin="0,0,0,6" />
                        </WrapPanel>

                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8" Padding="12" MaxHeight="360">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MacroStepsPanel" Spacing="6" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 卡片 3：本地试播与侧键绑定摘要 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center">
                            <Button x:Name="TestPlayBtn" Grid.Column="0" Content="测试回放当前草稿" Classes="tool" Margin="0,0,8,0" />
                            <Button x:Name="StopPlayBtn" Grid.Column="1" Content="停止回放" Classes="tool" Margin="0,0,14,0" />
                            <TextBlock x:Name="BindingSummaryText" Grid.Column="2" Classes="meta" VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar x:Name="PlaybackBar" Maximum="1" Minimum="0" Height="4" IsVisible="False" />
                    </StackPanel>
                </Border>
            </StackPanel>

        </Panel>
    </ScrollViewer>
</UserControl>

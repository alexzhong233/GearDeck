<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GearDeck.Desktop.Views.DevicesView"
    x:CompileBindings="False">

    <Grid Margin="24,20" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="设备总览" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="实时电量、休眠状态、低电量阈值、自定义图片与快速调参入口"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Panel x:Name="ViewSwitchSlot" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
            <Button x:Name="RefreshButton" Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, $default" FontSize="16"
                               VerticalAlignment="Center" />
                    <TextBlock Text="立即刷新所有外设" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Panel x:Name="DeviceHost" />
        </ScrollViewer>
    </Grid>
</UserControl>

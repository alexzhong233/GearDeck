<UserControl
    x:Class="GearDeck.Desktop.Views.SensitivityView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Button.tool.active">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Button.hint">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,28" Spacing="14">

            <StackPanel Spacing="4">
                <TextBlock Text="跨游戏灵敏度换算" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Classes="meta" Text="跨游戏 FOV、DPI 与灵敏度换算" />
            </StackPanel>

            <!-- 顶部可收缩游戏选择器（同时用于切换基准游戏与换算目标） -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="选择游戏" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="GameSummaryText" Classes="meta" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBox x:Name="GameSearchBox" Grid.Column="1" Width="210" Margin="12,0,8,0"
                                 VerticalAlignment="Center" Watermark="搜索游戏或引擎..." />
                        <Button x:Name="ToggleGamesBtn" Grid.Column="2" Classes="tool" Margin="0"
                                VerticalAlignment="Center" Content="展开选择 ▼" />
                    </Grid>
                    <StackPanel x:Name="GameCardsContainer" Spacing="8" IsVisible="False">
                        <TextBlock Classes="meta" Text="点击卡片按钮切换“设为基准”或“设为换算”；输入搜索词会自动展开列表。" />
                        <Panel x:Name="GameCardsHost" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid x:Name="WorkspaceGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 左侧基准卡 -->
                <Border x:Name="BaseCard" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="基准游戏" FontSize="16" FontWeight="SemiBold" />

                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock x:Name="BaseGameTitleText" Grid.Column="0" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="8,3"
                                    Margin="8,0,0,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock x:Name="BaseTagBadgeText" Classes="label" />
                            </Border>
                            <Button x:Name="SwapGamesBtn" Grid.Column="2" Classes="tool" Content="⇄ 互换"
                                    Margin="6,0,0,0" Padding="8,4" VerticalAlignment="Center"
                                    ToolTip.Tip="互换基准游戏与目标游戏" />
                        </Grid>

                        <WrapPanel>
                            <TextBlock Classes="label" Text="基准灵敏度" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox x:Name="BaseSensBox" Width="116" Margin="0,0,6,4" VerticalAlignment="Center" />
                            <Button x:Name="BaseSensHalfBtn" Classes="tool" Content="÷2" Margin="0,0,6,4" VerticalAlignment="Center" />
                            <Button x:Name="BaseSensDoubleBtn" Classes="tool" Content="×2" Margin="0,0,0,4" VerticalAlignment="Center" />
                        </WrapPanel>

                        <WrapPanel>
                            <TextBlock Classes="label" Text="基准 FOV" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox x:Name="BaseFovBox" Width="82" Margin="0,0,6,4" VerticalAlignment="Center" />
                            <Button x:Name="BaseFovResetBtn" Classes="tool" Content="默认" Margin="0,0,10,4" VerticalAlignment="Center" />
                            <TextBlock x:Name="BaseFovMetaText" Classes="meta" VerticalAlignment="Center" Margin="0,0,0,4" />
                        </WrapPanel>

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,2" />

                        <!-- 鼠标 DPI 集成 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="鼠标 DPI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="ReadMouseDpiBtn" Grid.Column="1" Content="读取鼠标 DPI"
                                    Classes="tool" Padding="8,4" Margin="0" />
                        </Grid>
                        <WrapPanel>
                            <TextBox x:Name="BaseDpiBox" Width="88" Margin="0,0,6,6" />
                            <Button Classes="tool" Tag="400" Content="400" Padding="8,5" />
                            <Button Classes="tool" Tag="800" Content="800" Padding="8,5" />
                            <Button Classes="tool" Tag="1600" Content="1600" Padding="8,5" />
                            <Button Classes="tool" Tag="3200" Content="3200" Padding="8,5" />
                        </WrapPanel>
                        <CheckBox x:Name="SameDpiCheck" Content="目标游戏使用相同 DPI" MinWidth="0" />
                        <StackPanel x:Name="TargetDpiPanel" Spacing="6" IsVisible="False">
                            <TextBlock Classes="label" Text="目标鼠标 DPI" />
                            <WrapPanel>
                                <TextBox x:Name="TargetDpiBox" Width="88" Margin="0,0,6,6" />
                                <Button Classes="tool" Tag="400" Content="400" Padding="8,5" />
                                <Button Classes="tool" Tag="800" Content="800" Padding="8,5" />
                                <Button Classes="tool" Tag="1600" Content="1600" Padding="8,5" />
                                <Button Classes="tool" Tag="3200" Content="3200" Padding="8,5" />
                            </WrapPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,2" />

                        <!-- 分辨率与比例集成 -->
                        <TextBlock Text="分辨率与比例" FontSize="14" FontWeight="SemiBold" />
                        <ComboBox x:Name="BaseResPresetCombo" HorizontalAlignment="Stretch" />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <TextBox x:Name="BaseWidthBox" Grid.Column="0" Watermark="宽" />
                            <TextBlock Grid.Column="1" Text="×" Classes="meta" Margin="8,0" VerticalAlignment="Center" />
                            <TextBox x:Name="BaseHeightBox" Grid.Column="2" Watermark="高" />
                        </Grid>
                        <WrapPanel>
                            <CheckBox x:Name="BaseStretchCheck" Content="4:3 拉伸满屏" MinWidth="0" Margin="0,0,14,0" />
                            <CheckBox x:Name="SameResCheck" Content="目标使用相同分辨率" MinWidth="0" />
                        </WrapPanel>
                        <StackPanel x:Name="TargetResPanel" Spacing="6" IsVisible="False">
                            <TextBlock Classes="label" Text="目标分辨率" />
                            <ComboBox x:Name="TargetResPresetCombo" HorizontalAlignment="Stretch" />
                            <Grid ColumnDefinitions="*,Auto,*">
                                <TextBox x:Name="TargetWidthBox" Grid.Column="0" Watermark="宽" />
                                <TextBlock Grid.Column="1" Text="×" Classes="meta" Margin="8,0" VerticalAlignment="Center" />
                                <TextBox x:Name="TargetHeightBox" Grid.Column="2" Watermark="高" />
                            </Grid>
                            <CheckBox x:Name="TargetStretchCheck" Content="目标 4:3 拉伸满屏" MinWidth="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 右侧目标换算卡 -->
                <Border x:Name="TargetCard" Grid.Row="0" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="目标游戏" FontSize="16" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="TargetGameTitleText" Grid.Column="0" FontSize="20" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="8,3"
                                        Margin="10,0,0,0"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock x:Name="TargetTagBadgeText" Classes="label" />
                                </Border>
                            </Grid>
                            <WrapPanel>
                                <TextBlock Classes="label" Text="目标 FOV" VerticalAlignment="Center" Margin="0,0,8,4" />
                                <TextBox x:Name="TargetFovBox" Width="82" Margin="0,0,6,4" VerticalAlignment="Center" />
                                <Button x:Name="TargetFovResetBtn" Classes="tool" Content="默认" Margin="0,0,10,4" VerticalAlignment="Center" />
                                <TextBlock x:Name="TargetFovMetaText" Classes="meta" VerticalAlignment="Center" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- 三种转换情况直出对比 -->
                        <UniformGrid x:Name="ResultModesGrid" Columns="3">
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10" Padding="12" Margin="0,0,5,6">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="360° 等距" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="hint" Content="?"
                                                ToolTip.Tip="保持物理转身距离（cm/360°）完全一致，适合腰射转身肌肉记忆，跨游戏最通用。" />
                                    </Grid>
                                    <TextBlock x:Name="ResultCm360Text" FontSize="24" FontWeight="Bold" />
                                    <TextBlock x:Name="ResultCm360SubText" Classes="meta" />
                                    <Button x:Name="CopyCm360Btn" Classes="tool" Content="复制" Margin="0" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10" Padding="12" Margin="3,0,3,6">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="FOV 焦距缩放" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="hint" Content="?"
                                                ToolTip.Tip="MDV 0%（焦距缩放）：保持准星中心附近视觉角速度一致，适合不同 FOV 之间跟枪与微调。" />
                                    </Grid>
                                    <TextBlock x:Name="ResultMdv0Text" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Classes="meta" Text="MDV 0% · 中心跟枪" />
                                    <Button x:Name="CopyMdv0Btn" Classes="tool" Content="复制" Margin="0" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="10" Padding="12" Margin="5,0,0,6">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="水平边缘对齐" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="hint" Content="?"
                                                ToolTip.Tip="MDH 100%：按实际水平视野（HFOV）等比缩放，保证从准星中心拉枪到屏幕左右边缘的物理距离一致。" />
                                    </Grid>
                                    <TextBlock x:Name="ResultMdh100Text" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Classes="meta" Text="MDH 100% · 边缘落点" />
                                    <Button x:Name="CopyMdh100Btn" Classes="tool" Content="复制" Margin="0" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <StackPanel x:Name="ConfigSnippetPanel" Spacing="6" IsVisible="False">
                            <TextBlock x:Name="ConfigSnippetText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                            <Button x:Name="CopySnippetBtn" Content="复制命令" Classes="tool" HorizontalAlignment="Left" Margin="0" />
                        </StackPanel>

                        <StackPanel x:Name="DynamicWarningsPanel" Spacing="6" />

                        <!-- 物理参数与修改指引（常驻展开） -->
                        <StackPanel x:Name="DetailsContainer" Spacing="8">
                            <Border CornerRadius="8" Padding="12"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="物理参数与传感器参考" />
                                    <TextBlock x:Name="MetricPhysicalText" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="该游戏怎么改" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="GuideSettingPathText" Classes="meta" />
                                <TextBlock x:Name="GuideConfigTipText" Classes="meta" />
                                <TextBlock x:Name="GuideAdsTipText" Classes="meta" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

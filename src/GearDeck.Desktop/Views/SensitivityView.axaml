<UserControl
    x:Class="GearDeck.Desktop.Views.SensitivityView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Button.tool.active">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,28" Spacing="14">

            <StackPanel Spacing="4">
                <TextBlock Text="跨游戏灵敏度换算" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Classes="meta" Text="跨游戏 FOV、DPI 与灵敏度换算" />
            </StackPanel>

            <Grid x:Name="WorkspaceGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 左侧基准卡（集成 DPI 与分辨率设置） -->
                <Border x:Name="BaseCard" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="基准游戏设置" FontSize="16" FontWeight="SemiBold" />

                        <TextBlock Classes="label" Text="基准游戏" />
                        <ComboBox x:Name="BaseGameCombo" HorizontalAlignment="Stretch" />

                        <TextBlock Classes="label" Text="基准灵敏度" />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox x:Name="BaseSensBox" Grid.Column="0" Margin="0,0,6,0" />
                            <Button x:Name="BaseSensHalfBtn" Grid.Column="1" Classes="tool" Content="÷2" Margin="0,0,6,0" />
                            <Button x:Name="BaseSensDoubleBtn" Grid.Column="2" Classes="tool" Content="×2" Margin="0" />
                        </Grid>

                        <TextBlock Classes="label" Text="基准 FOV" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox x:Name="BaseFovBox" Grid.Column="0" Margin="0,0,6,0" />
                            <Button x:Name="BaseFovResetBtn" Grid.Column="1" Classes="tool" Content="默认" Margin="0" />
                        </Grid>
                        <TextBlock x:Name="BaseFovMetaText" Classes="meta" />

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,2" />

                        <!-- 鼠标 DPI 集成 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="鼠标 DPI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="ReadMouseDpiBtn" Grid.Column="1" Content="读取鼠标 DPI"
                                    Classes="tool" Padding="8,4" Margin="0" />
                        </Grid>
                        <WrapPanel>
                            <TextBox x:Name="BaseDpiBox" Width="88" Margin="0,0,6,6" />
                            <Button Classes="tool" Tag="400" Content="400" Padding="8,5" />
                            <Button Classes="tool" Tag="800" Content="800" Padding="8,5" />
                            <Button Classes="tool" Tag="1600" Content="1600" Padding="8,5" />
                            <Button Classes="tool" Tag="3200" Content="3200" Padding="8,5" />
                        </WrapPanel>
                        <CheckBox x:Name="SameDpiCheck" Content="目标游戏使用相同 DPI" MinWidth="0" />
                        <StackPanel x:Name="TargetDpiPanel" Spacing="6" IsVisible="False">
                            <TextBlock Classes="label" Text="目标鼠标 DPI" />
                            <WrapPanel>
                                <TextBox x:Name="TargetDpiBox" Width="88" Margin="0,0,6,6" />
                                <Button Classes="tool" Tag="400" Content="400" Padding="8,5" />
                                <Button Classes="tool" Tag="800" Content="800" Padding="8,5" />
                                <Button Classes="tool" Tag="1600" Content="1600" Padding="8,5" />
                                <Button Classes="tool" Tag="3200" Content="3200" Padding="8,5" />
                            </WrapPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,2" />

                        <!-- 分辨率与比例集成 -->
                        <TextBlock Text="分辨率与比例" FontSize="14" FontWeight="SemiBold" />
                        <ComboBox x:Name="BaseResPresetCombo" HorizontalAlignment="Stretch" />
                        <Grid ColumnDefinitions="*,Auto,*">
                            <TextBox x:Name="BaseWidthBox" Grid.Column="0" Watermark="宽" />
                            <TextBlock Grid.Column="1" Text="×" Classes="meta" Margin="8,0" VerticalAlignment="Center" />
                            <TextBox x:Name="BaseHeightBox" Grid.Column="2" Watermark="高" />
                        </Grid>
                        <WrapPanel>
                            <CheckBox x:Name="BaseStretchCheck" Content="4:3 拉伸满屏" MinWidth="0" Margin="0,0,14,0" />
                            <CheckBox x:Name="SameResCheck" Content="目标使用相同分辨率" MinWidth="0" />
                        </WrapPanel>
                        <StackPanel x:Name="TargetResPanel" Spacing="6" IsVisible="False">
                            <TextBlock Classes="label" Text="目标分辨率" />
                            <ComboBox x:Name="TargetResPresetCombo" HorizontalAlignment="Stretch" />
                            <Grid ColumnDefinitions="*,Auto,*">
                                <TextBox x:Name="TargetWidthBox" Grid.Column="0" Watermark="宽" />
                                <TextBlock Grid.Column="1" Text="×" Classes="meta" Margin="8,0" VerticalAlignment="Center" />
                                <TextBox x:Name="TargetHeightBox" Grid.Column="2" Watermark="高" />
                            </Grid>
                            <CheckBox x:Name="TargetStretchCheck" Content="目标 4:3 拉伸满屏" MinWidth="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 右侧目标换算卡 -->
                <Border x:Name="TargetCard" Grid.Row="0" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Top"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <!-- 标题行与 FOV/互换控制分行，避免窄窗口重叠 -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="TargetGameTitleText" Grid.Column="0" FontSize="20" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="6" Padding="8,3"
                                        Margin="10,0,0,0"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock x:Name="TargetTagBadgeText" Classes="label" />
                                </Border>
                            </Grid>
                            <WrapPanel>
                                <TextBlock Classes="label" Text="目标 FOV" VerticalAlignment="Center" Margin="0,0,8,6" />
                                <TextBox x:Name="TargetFovBox" Width="88" Margin="0,0,6,6" />
                                <Button x:Name="TargetFovResetBtn" Classes="tool" Content="默认" />
                                <Button x:Name="SwapGamesBtn" Classes="tool" Content="互换基准/目标" />
                            </WrapPanel>
                            <TextBlock x:Name="TargetFovMetaText" Classes="meta" />
                        </StackPanel>

                        <TextBlock Text="转换算法" FontSize="14" FontWeight="SemiBold" />
                        <WrapPanel>
                            <Button x:Name="MethodCm360Btn" Classes="tool" Tag="Cm360" Content="360° 等距" />
                            <Button x:Name="MethodMdv0Btn" Classes="tool" Tag="Mdv0" Content="FOV 焦距缩放 (MDV 0%)" />
                            <Button x:Name="MethodMdh100Btn" Classes="tool" Tag="Mdh100" Content="水平边缘对齐 (MDH 100%)" />
                        </WrapPanel>
                        <TextBlock x:Name="MethodDescText" Classes="meta" />

                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="PrimaryResultText" FontSize="34" FontWeight="Bold" />
                                    <TextBlock x:Name="PrimaryMethodTagText" Classes="meta" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button x:Name="CopySensBtn" Content="复制灵敏度" Margin="0,0,6,6" />
                                    <StackPanel x:Name="ConfigSnippetPanel" Spacing="6" IsVisible="False" Margin="0,0,6,6">
                                        <TextBlock x:Name="ConfigSnippetText" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <Button x:Name="CopySnippetBtn" Content="复制命令" Padding="10,5" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Padding="12" Margin="0,0,5,5"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="360° 等距 vs 焦距缩放" />
                                    <TextBlock x:Name="MetricCompareText" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" CornerRadius="8" Padding="12" Margin="5,0,0,5"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="物理转身 cm/360° &amp; eDPI" />
                                    <TextBlock x:Name="MetricCm360Text" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" CornerRadius="8" Padding="12" Margin="0,5,5,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="实际视野 HFOV / VFOV" />
                                    <TextBlock x:Name="MetricFovText" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Padding="12" Margin="5,5,0,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="label" Text="像素步进 &amp; 2K 跑满手速" />
                                    <TextBlock x:Name="MetricPixelSpeedText" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="该游戏怎么改" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="GuideSettingPathText" TextWrapping="Wrap" />
                            <TextBlock x:Name="GuideConfigTipText" TextWrapping="Wrap" />
                            <TextBlock x:Name="GuideAdsTipText" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="DynamicWarningsPanel" Spacing="6" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 游戏一览（精简为搜索框 + 双按钮响应式卡片墙） -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="游戏一览" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="GameSearchBox" Grid.Column="1" Width="220" Margin="12,0,0,0"
                                 Watermark="搜索游戏或引擎..." />
                    </Grid>
                    <Panel x:Name="GameCardsHost" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

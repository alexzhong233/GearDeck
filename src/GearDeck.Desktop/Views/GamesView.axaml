<UserControl
    x:Class="GearDeck.Desktop.Views.GamesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="RootShellGrid" Margin="24,18,24,28" RowDefinitions="Auto,*" ColumnDefinitions="284,*">
        <!-- 顶部标题与卡片/列表视图切换 -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Text="游戏与配置切换" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Classes="meta" Text="按游戏进程或全屏状态自动切换外设配置" />
            </StackPanel>
            <StackPanel x:Name="ViewSwitchSlot" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- 左侧常驻栏：自动切换控制 + 前台进程 + 生效策略 -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,12,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="自动切换控制" FontSize="15" FontWeight="SemiBold" />
                        <ToggleSwitch x:Name="AutoSwitchToggle"
                                      Content="启动自动切换"
                                      OnContent="已开启"
                                      OffContent="已关闭"
                                      IsCheckedChanged="OnGlobalSettingsToggled" />
                        <ToggleSwitch x:Name="NotifySwitchToggle"
                                      Content="配置切换原生通知"
                                      OnContent="已开启"
                                      OffContent="已关闭"
                                      IsCheckedChanged="OnGlobalSettingsToggled" />
                        <Button Content="立即检测并应用" HorizontalAlignment="Stretch"
                                Classes="accent" Click="OnForceReevaluate" />
                    </StackPanel>
                </Border>

                <!-- 前台进程 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="前台进程" FontSize="15" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border x:Name="ForegroundIconHost" Grid.Column="0" Width="36" Height="36"
                                        CornerRadius="8"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="ForegroundProcNameText" FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Text="检测中..." />
                                    <TextBlock x:Name="ForegroundWindowModeText" FontSize="11" Classes="label"
                                               TextTrimming="CharacterEllipsis" Text="【普通窗口】" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 生效策略 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="生效策略" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="ActiveRuleStatusText" FontSize="12" FontWeight="SemiBold"
                                   Text="--" TextWrapping="Wrap" />
                        <StackPanel x:Name="ActiveDeviceStrategiesPanel" Spacing="6" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧分段标签导航 + 内容区域 -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="12,12,0,0" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                <Button x:Name="TabGamesBtn" Classes="accent" Tag="games" Padding="14,7" Content="游戏" />
                <Button x:Name="TabFullscreenBtn" Tag="fullscreen" Padding="14,7" Content="全屏策略" />
                <Button x:Name="TabPresetsBtn" Tag="presets" Padding="14,7" Content="预设管理" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" Margin="0,0,8,24">

                    <!-- TAB 1：游戏库 / 单游戏专属配置 -->
                    <StackPanel x:Name="PanelGames" Spacing="14" IsVisible="True">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="手动新增到本机游戏库" FontSize="16" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <ComboBox x:Name="RunningProcCombo" HorizontalAlignment="Stretch"
                                              PlaceholderText="点击右侧刷新运行列表..."
                                              SelectionChanged="OnRunningProcSelected" />
                                    <Button Grid.Column="1" Content="刷新运行列表" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Classes="tool" Click="OnRefreshRunningProcs" />
                                </Grid>
                                <Grid ColumnDefinitions="*,1.4*,Auto">
                                    <TextBox x:Name="NewRuleNameBox" Watermark="游戏名称（如 CS2）" />
                                    <TextBox x:Name="NewRuleProcessBox" Grid.Column="1" Margin="8,0,0,0"
                                             Watermark="进程名（如 cs2.exe）" />
                                    <Button Grid.Column="2" Content="浏览 .exe..." Margin="8,0,0,0"
                                            VerticalAlignment="Center" Classes="tool" Click="OnBrowseExe" />
                                </Grid>
                                <WrapPanel>
                                    <Button Content="+ 添加到本机游戏库" Classes="accent" Margin="0,0,10,4"
                                            Click="OnAddManualGame" />
                                    <TextBlock Classes="meta" Text="添加后点击下方游戏卡片即可在弹窗中配置外设方案并开启开关"
                                               VerticalAlignment="Center" Margin="0,0,0,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="本机游戏库" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ScannedGamesHint" Classes="meta"
                                                   Text="正在扫描本机已安装游戏..." />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBox x:Name="GameFilterBox" Width="180" Watermark="搜索游戏或 .exe..."
                                                 TextChanged="OnGameFilterChanged" />
                                        <Button x:Name="ScanGamesBtn" Content="重新扫描" Classes="accent"
                                                Click="OnScanInstalledGames" />
                                    </StackPanel>
                                </Grid>
                                <Panel x:Name="ScannedGamesHost" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 2：全屏策略 -->
                    <StackPanel x:Name="PanelFullscreen" Spacing="14" IsVisible="False">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="全屏独占与退出恢复策略" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Classes="meta" Text="未命中单游戏规则时，按下方全屏触发与退出恢复策略统一切换。" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="FullscreenMasterToggle" Grid.Column="1"
                                                  Margin="14,0,0,0"
                                                  Content="全局独占策略总开关"
                                                  OnContent="已开启"
                                                  OffContent="已关闭"
                                                  VerticalAlignment="Center"
                                                  IsCheckedChanged="OnFullscreenMasterToggled" />
                                </Grid>
                                <StackPanel x:Name="StrategyCardsHost" Spacing="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 3：预设管理 -->
                    <StackPanel x:Name="PanelPresets" Spacing="14" IsVisible="False">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="厂家板载预设读取与分硬件参数预设库" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Classes="meta" Text="可直接读取每台硬件自身存储的厂家板载预设（写入游戏规则下拉），也可在此抓存新的专属预设。" />
                                </StackPanel>
                                <Panel x:Name="DevicePresetsQuickHost" />
                                <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Grid ColumnDefinitions="*,1.2*,Auto">
                                    <ComboBox x:Name="CaptureMouseCombo" HorizontalAlignment="Stretch" />
                                    <TextBox x:Name="PresetNameBox" Grid.Column="1" Margin="8,0,0,0"
                                             Watermark="例如：FPS 800 DPI 4K / 桌面节能" />
                                    <Button x:Name="CapturePresetBtn" Grid.Column="2" Margin="8,0,0,0"
                                            Content="保存至该设备预设" Classes="accent" VerticalAlignment="Center"
                                            Click="OnCapturePreset" />
                                </Grid>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="快速参数预设（按设备配置 DPI / 回报率 / LOD）" FontSize="14" FontWeight="SemiBold" />
                                    <WrapPanel>
                                        <ui:NumberBox x:Name="QuickDpiBox" Header="DPI" Width="120" Maximum="45000" Minimum="100" Margin="0,0,8,8" />
                                        <ui:NumberBox x:Name="QuickPollingBox" Header="回报率 Hz" Width="120" Maximum="8000" Minimum="0" Margin="0,0,8,8" />
                                        <ui:NumberBox x:Name="QuickLodBox" Header="LOD" Width="105" Maximum="100" Minimum="0" Margin="0,0,8,8" />
                                        <Button x:Name="QuickPresetBtn" Content="生成参数预设" Classes="tool"
                                                VerticalAlignment="Bottom" Margin="0,0,0,8" Click="OnQuickPreset" />
                                    </WrapPanel>
                                </StackPanel>
                                <Panel x:Name="PresetsHost" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

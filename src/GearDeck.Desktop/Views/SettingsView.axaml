<UserControl
    x:Class="GearDeck.Desktop.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,28" Spacing="14">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Classes="meta"
                               Text="设备轮询、低电量提醒、托盘常驻、云端图库、GitHub 更新与调试模式。数值项修改后点击「保存设置」生效。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedHintText" Classes="meta" VerticalAlignment="Center" />
                    <Button x:Name="SaveBtn" Content="保存设置" Classes="accent" Padding="18,8" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="CardsGrid" ColumnDefinitions="*,14,*" RowDefinitions="Auto,Auto">
                <StackPanel x:Name="LeftColumnPanel" Grid.Row="0" Grid.Column="0" Spacing="14">

                    <!-- 低电量与通知 -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="cardTitle" Text="低电量与通知" />
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="全局低电量" VerticalAlignment="Center" />
                                    <ui:NumberBox x:Name="LowBatteryThresholdBox"
                                                  Width="124"
                                                  Maximum="80" Minimum="5"
                                                  SmallChange="1" LargeChange="5"
                                                  SpinButtonPlacementMode="Inline"
                                                  VerticalAlignment="Center" />
                                    <TextBlock Text="%" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="meta" Text="范围 5%~80%，单设备可在设备详情页单独覆写此阈值" />
                            </StackPanel>
                            <WrapPanel>
                                <ToggleSwitch x:Name="GlobalLowBatNotifySwitch"
                                              Content="全局低电量通知"
                                              OnContent="开启" OffContent="关闭"
                                              MinWidth="0" Margin="0,0,18,4" />
                                <ToggleSwitch x:Name="NotifySwitch"
                                              Content="配置切换通知"
                                              OnContent="开启" OffContent="关闭"
                                              MinWidth="0" Margin="0,0,18,4" />
                                <ToggleSwitch x:Name="AutoYieldSwitch"
                                              Content="官方驱动让位"
                                              OnContent="开启" OffContent="关闭"
                                              MinWidth="0" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 窗口与托盘 -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="cardTitle" Text="窗口与托盘" />
                            <WrapPanel>
                                <ToggleSwitch x:Name="CloseToTraySwitch"
                                              Content="关闭常驻托盘"
                                              OnContent="开启" OffContent="关闭"
                                              MinWidth="0" Margin="0,0,18,4" />
                                <ToggleSwitch x:Name="LaunchMinimizedSwitch"
                                              Content="启动静默最小化"
                                              OnContent="开启" OffContent="关闭"
                                              MinWidth="0" Margin="0,0,18,4" />
                                <ToggleSwitch x:Name="StartupSwitch"
                                              Content="开机自动启动"
                                              OnContent="开启" OffContent="关闭"
                                              MinWidth="0" Margin="0,0,0,4" />
                            </WrapPanel>
                            <TextBlock x:Name="StartupHintText" Classes="meta" />
                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,4" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="取消勾选系统监控分组行为" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MonitorUncheckActionHintText" Classes="meta" />
                                </StackPanel>
                                <Button x:Name="ResetMonitorUncheckBtn" Grid.Column="1"
                                        Content="重置为每次询问"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Debug 调试模式（独立卡片 + 写盘警告） -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="cardTitle" Text="Debug 调试模式" />
                            <ToggleSwitch x:Name="DebugSwitch"
                                          Content="开启调试模式（显示「诊断」栏）"
                                          OnContent="开启" OffContent="关闭"
                                          MinWidth="0" />
                            <TextBlock Classes="meta"
                                       Text="开启后会持续向本地磁盘写入详细诊断日志（diag.log / widget.log），可能会增加 SSD 读写与占用少许性能；仅在排查设备协议或异常问题时开启，日常无需开启。" />
                        </StackPanel>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="RightColumnPanel" Grid.Row="0" Grid.Column="2" Spacing="14">

                    <!-- 轮询间隔：Value 由代码在 _binding=true 时赋值，不在 AXAML 内联 -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="cardTitle" Text="轮询间隔" />
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="HID 设备轮询" VerticalAlignment="Center" />
                                    <ui:NumberBox x:Name="PollIntervalBox"
                                                  Width="124"
                                                  Maximum="300" Minimum="5"
                                                  SmallChange="1" LargeChange="15"
                                                  SpinButtonPlacementMode="Inline"
                                                  VerticalAlignment="Center" />
                                    <TextBlock Text="秒" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="meta" Text="范围 5~300 秒，推荐默认 15 秒；缩短可提高电量与状态刷新频率" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 云端设备图库 -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="cardTitle" Text="云端设备图库" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="CloudManifestUrlBox" Grid.Column="0"
                                         Watermark="自定义云端规则 JSON URL（可选；留空使用内置规则）" />
                                <Button x:Name="SyncCloudImagesBtn" Grid.Column="1"
                                        Content="同步云端设备图片"
                                        Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="ImageSyncHintText" Classes="meta" />
                        </StackPanel>
                    </Border>

                    <!-- 在线更新 -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="cardTitle" Text="在线更新" />
                            <Grid ColumnDefinitions="*,14,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Classes="meta" Text="更新下载通道" />
                                    <ComboBox x:Name="MirrorChannelCombo" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoCheckUpdateSwitch" Grid.Column="2"
                                              Content="启动自动检查"
                                              OnContent="开启" OffContent="关闭"
                                              MinWidth="0" VerticalAlignment="Bottom" />
                            </Grid>
                            <WrapPanel>
                                <Button x:Name="CheckUpdateBtn" Content="立即检查更新" Classes="accent" Margin="0,0,8,4" />
                                <Button x:Name="DownloadUpdateBtn" Content="立即下载并更新重启" IsVisible="False" Margin="0,0,8,4" />
                                <Button x:Name="OpenReleasesBtn" Content="打开 GitHub Releases" Margin="0,0,0,4" />
                            </WrapPanel>
                            <ProgressBar x:Name="UpdateProgressBar" Maximum="100" Minimum="0"
                                         Height="8" IsVisible="False" />
                            <TextBlock x:Name="UpdateStatusText" Classes="meta" />
                            <Border x:Name="ReleaseNotesCard" IsVisible="False" Padding="12" CornerRadius="6"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="ReleaseNotesTitleText" FontWeight="SemiBold" />
                                    <SelectableTextBlock x:Name="ReleaseNotesText" Classes="meta" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

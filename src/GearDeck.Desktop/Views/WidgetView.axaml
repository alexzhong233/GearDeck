<UserControl
    x:Class="GearDeck.Desktop.Views.WidgetView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="TextBlock.meta">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,28" Spacing="14">

            <!-- 顶部标题与卡片/列表切换 -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PageTitleText" Text="任务栏贴片" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitleText" Classes="meta" Text="配置贴片位置、触发方式、分组与监控指标" />
                </StackPanel>
                <Panel x:Name="ViewSwitchSlot" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <!-- macOS 菜单栏状态面板 -->
            <StackPanel x:Name="MacStatusPanel" IsVisible="False" Spacing="14">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="macOS 菜单栏平铺显示" FontSize="16" FontWeight="SemiBold" />
                        <WrapPanel>
                            <ToggleSwitch x:Name="MacTiledSwitch" MinWidth="0" Margin="0,0,22,4"
                                          OnContent="平铺显示外设分组电量"
                                          OffContent="仅显示单条摘要" />
                        </WrapPanel>
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8" Padding="12,8">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="meta" Text="当前菜单栏实时预览" />
                                <Image x:Name="MacPreviewImage"
                                       Height="22"
                                       HorizontalAlignment="Left"
                                       Stretch="Uniform"
                                       IsVisible="False" />
                                <TextBlock x:Name="MacPreviewText"
                                           FontFamily="Consolas,Menlo,Monaco,monospace"
                                           FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <WrapPanel>
                            <Button x:Name="MacOpenMonitorBtn" Content="打开桌面悬浮监控条" Height="30" Padding="12,0" Margin="0,0,8,4" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Windows 显示与位置（紧凑排版） -->
            <StackPanel x:Name="WindowsWidgetPanel" Spacing="14">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="显示与位置" FontSize="16" FontWeight="SemiBold" />

                        <!-- 第一行：三个核心开关同排显示 -->
                        <WrapPanel>
                            <ToggleSwitch x:Name="VisibleSwitch" MinWidth="0" Margin="0,0,22,4"
                                          OnContent="显示贴片" OffContent="隐藏贴片" />
                            <ToggleSwitch x:Name="EmbedSwitch" MinWidth="0" Margin="0,0,22,4"
                                          OnContent="固定到任务栏" OffContent="桌面自由悬浮" />
                            <ToggleSwitch x:Name="FlyoutHoverSwitch" MinWidth="0" Margin="0,0,0,4"
                                          OnContent="悬停显示浮窗" OffContent="点击显示浮窗" />
                        </WrapPanel>

                        <!-- 第二行：预设位置与水平微调合并为紧凑一行 -->
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,18,4" VerticalAlignment="Center">
                                <TextBlock Text="预设位置" Classes="meta" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <Button x:Name="PresetLeftWeatherBtn" Content="左侧" Height="28" Padding="10,0" FontSize="12"
                                        ToolTip.Tip="靠左（天气旁）" />
                                <Button x:Name="PresetMidLeftBtn" Content="中左" Height="28" Padding="10,0" FontSize="12" />
                                <Button x:Name="PresetMidRightBtn" Content="中右" Height="28" Padding="10,0" FontSize="12" />
                                <Button x:Name="PresetRightTrayBtn" Content="右侧" Height="28" Padding="10,0" FontSize="12"
                                        ToolTip.Tip="靠右（托盘旁）" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="水平微调" Classes="meta" VerticalAlignment="Center"
                                           ToolTip.Tip="负数向左，正数向右，也可直接在任务栏拖动" />
                                <Slider x:Name="OffsetSlider" Maximum="1200" Minimum="-1200"
                                        Width="150" VerticalAlignment="Center" />
                                <ui:NumberBox x:Name="OffsetBox" Width="128" Maximum="2000" Minimum="-2000"
                                              SmallChange="1" LargeChange="10"
                                              SpinButtonPlacementMode="Inline" VerticalAlignment="Center" />
                                <Button x:Name="ResetOffsetBtn" Content="归零" Height="28" Padding="10,0"
                                        FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,18,2" VerticalAlignment="Center">
                                <TextBlock Text="贴片高度" Classes="meta" VerticalAlignment="Center" />
                                <ui:NumberBox x:Name="HeightBox" Maximum="60" Minimum="24" Width="124"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,18,2" VerticalAlignment="Center">
                                <TextBlock Text="字号" Classes="meta" VerticalAlignment="Center" />
                                <ui:NumberBox x:Name="FontBox" Maximum="20" Minimum="9" Width="118"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2" VerticalAlignment="Center">
                                <TextBlock Text="每组最小宽度" Classes="meta" VerticalAlignment="Center" />
                                <ui:NumberBox x:Name="BlockBox" Maximum="220" Minimum="48" Width="128"
                                              SmallChange="1" SpinButtonPlacementMode="Inline" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 分组与系统监控（支持卡片 / 列表视图） -->
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="分组与监控" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="meta" Text="勾选、排序与指标配置实时同步到任务栏/菜单栏" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
                <Panel x:Name="GroupHost" />
            </StackPanel>

            <!-- 新建自定义组（卡片样式） -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="新建自定义组" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Classes="meta" Text="输入组名并勾选外设，将独立显示为任务栏分组块" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="GroupNameBox" Grid.Column="0" Watermark="组名，例如：FPS 鼠标" />
                        <Button x:Name="CreateGroupBtn" Grid.Column="1" Content="创建组" Classes="accent"
                                Height="32" Padding="14,0" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <WrapPanel x:Name="DeviceCheckHost" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

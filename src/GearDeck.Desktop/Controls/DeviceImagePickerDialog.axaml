<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GearDeck.Desktop.Controls.DeviceImagePickerDialog"
    x:CompileBindings="False"
    Title="选择设备展示图片"
    Width="640"
    Height="560"
    MinWidth="520"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="TitleText" Text="设备图片" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
                <Border CornerRadius="10" Padding="14"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="82" Height="82" CornerRadius="12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Image x:Name="PreviewImage" Width="72" Height="72" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="按 VID:PID 与型号自动匹配线上产品图；也可上传本地图片或清除覆盖恢复匹配。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <WrapPanel>
                                <Button x:Name="UploadBtn" Content="从本地上传图片..." Click="OnUploadClick"
                                        Margin="0,0,8,8" />
                                <Button x:Name="ResetBtn" Content="清除覆盖 / 恢复匹配" Click="OnResetClick"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="预设造型（按识别 ID 优先推荐）" FontWeight="SemiBold" />
                    <WrapPanel x:Name="PresetPanel" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="DoneBtn" Content="完成" Click="OnDoneClick" />
        </StackPanel>
    </Grid>
</Window>

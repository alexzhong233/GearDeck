<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="GearDeck.Desktop.Controls.DeviceImagePickerDialog"
    x:CompileBindings="False"
    Title="选择设备展示图片"
    Width="680"
    Height="600"
    MinWidth="520"
    MinHeight="460"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="TitleText" Text="设备图片" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,12" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <Border CornerRadius="10" Padding="14"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="84" Height="84" CornerRadius="12"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Image x:Name="PreviewImage" Width="74" Height="74" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="按 VID:PID 与型号自动匹配线上产品图 / SVG；也可上传本地图片、清除覆盖或输入自定义直链。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="UploadBtn" Content="上传本地图片..." Click="OnUploadClick" />
                                <Button x:Name="ResetBtn" Content="清除覆盖 / 恢复匹配" Click="OnResetClick" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="UrlBox"
                             Watermark="或输入图片直链 URL (.png / .jpg / .webp / .svg)"
                             HorizontalAlignment="Stretch" />
                    <Button x:Name="PullUrlBtn" Grid.Column="1" Margin="8,0,0,0"
                            Content="拉取并应用" Click="OnPullUrlClick" />
                </Grid>

                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="PresetHeaderText" Text="预设与云端图库" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="PresetCountText" Grid.Column="1" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBox x:Name="SearchBox"
                             Watermark="搜索品牌或型号（如 Viper / Keychron / Pulsar / Superlight）..."
                             TextChanged="OnSearchTextChanged" />
                    <WrapPanel x:Name="PresetPanel" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="DoneBtn" Content="完成" Click="OnDoneClick" />
        </StackPanel>
    </Grid>
</Window>

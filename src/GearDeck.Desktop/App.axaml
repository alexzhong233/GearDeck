<Application
    x:Class="GearDeck.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sty="using:FluentAvalonia.Styling">
    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
    </Application.Styles>
    <Application.Resources>
        <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Microsoft YaHei UI, PingFang SC, Inter, $default</FontFamily>
    </Application.Resources>
</Application>

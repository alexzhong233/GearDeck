<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" />
    <PackageReference Include="Svg.Skia" Version="1.0.0.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GearDeck.Core\GearDeck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\app.png" />
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\device-images.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\device-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyWidget" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_WidgetFiles Include="..\GearDeck.Widget\bin\x64\$(Configuration)\net8.0-windows\**\*.*"
                    Condition="Exists('..\GearDeck.Widget\bin\x64\$(Configuration)\net8.0-windows\GearDeck.Widget.exe')" />
      <_WidgetFiles Include="..\GearDeck.Widget\bin\AnyCPU\$(Configuration)\net8.0-windows\**\*.*"
                    Condition="!Exists('..\GearDeck.Widget\bin\x64\$(Configuration)\net8.0-windows\GearDeck.Widget.exe') and Exists('..\GearDeck.Widget\bin\AnyCPU\$(Configuration)\net8.0-windows\GearDeck.Widget.exe')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WidgetFiles)"
          DestinationFolder="$(OutDir)widget\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_WidgetFiles)' != ''" />
  </Target>

  <Target Name="CopyWidgetToPublish" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_WidgetPubFiles Include="..\GearDeck.Widget\bin\x64\$(Configuration)\net8.0-windows\**\*.*"
                       Condition="Exists('..\GearDeck.Widget\bin\x64\$(Configuration)\net8.0-windows\GearDeck.Widget.exe')" />
      <_WidgetPubFiles Include="..\GearDeck.Widget\bin\AnyCPU\$(Configuration)\net8.0-windows\**\*.*"
                       Condition="!Exists('..\GearDeck.Widget\bin\x64\$(Configuration)\net8.0-windows\GearDeck.Widget.exe') and Exists('..\GearDeck.Widget\bin\AnyCPU\$(Configuration)\net8.0-windows\GearDeck.Widget.exe')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WidgetPubFiles)"
          DestinationFolder="$(PublishDir)widget\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != '' and !Exists('$(PublishDir)widget\GearDeck.Widget.exe') and '@(_WidgetPubFiles)' != ''" />
  </Target>
</Project>

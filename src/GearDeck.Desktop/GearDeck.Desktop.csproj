<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <DefineConstants>$(DefineConstants);GEARDECK_DESKTOP</DefineConstants>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SystemMetricsEngine.cs" Link="Services\SystemMetricsEngine.cs" />
    <Compile Include="..\Shared\HwInfoSharedMemoryReader.cs" Link="Services\HwInfoSharedMemoryReader.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" />
    <PackageReference Include="Svg.Skia" Version="1.0.0.18" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GearDeck.Core\GearDeck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\app.png" />
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\device-images.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\device-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyWidget" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <MSBuild Projects="..\GearDeck.Widget\GearDeck.Widget.csproj"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;PublishSingleFile"
             Condition="'$(DesignTimeBuild)' != 'true' and '$(RuntimeIdentifier)' == '' and Exists('..\GearDeck.Widget\obj\project.assets.json')" />
    <PropertyGroup>
      <_WidgetOutDir Condition="Exists('..\GearDeck.Widget\bin\x64\$(Configuration)\net8.0-windows\GearDeck.Widget.exe')">..\GearDeck.Widget\bin\x64\$(Configuration)\net8.0-windows\</_WidgetOutDir>
      <_WidgetOutDir Condition="'$(_WidgetOutDir)' == '' and Exists('..\GearDeck.Widget\bin\AnyCPU\$(Configuration)\net8.0-windows\GearDeck.Widget.exe')">..\GearDeck.Widget\bin\AnyCPU\$(Configuration)\net8.0-windows\</_WidgetOutDir>
      <_WidgetOutDir Condition="'$(_WidgetOutDir)' == '' and Exists('..\GearDeck.Widget\bin\$(Configuration)\net8.0-windows\GearDeck.Widget.exe')">..\GearDeck.Widget\bin\$(Configuration)\net8.0-windows\</_WidgetOutDir>
      <_WidgetOutDir Condition="'$(_WidgetOutDir)' == '' and Exists('..\GearDeck.Widget\bin\$(Configuration)\net8.0-windows\win-x64\GearDeck.Widget.exe')">..\GearDeck.Widget\bin\$(Configuration)\net8.0-windows\win-x64\</_WidgetOutDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(_WidgetOutDir)' != ''">
      <_WidgetFiles Include="$(_WidgetOutDir)GearDeck.Widget.exe" />
      <_WidgetFiles Include="$(_WidgetOutDir)GearDeck.Widget.dll" />
      <_WidgetFiles Include="$(_WidgetOutDir)GearDeck.Widget.deps.json" />
      <_WidgetFiles Include="$(_WidgetOutDir)GearDeck.Widget.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_WidgetFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_WidgetFiles)' != ''" />
    <RemoveDir Directories="$(OutDir)widget" Condition="Exists('$(OutDir)widget')" />
  </Target>

  <Target Name="CopyWidgetToPublish" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <_WidgetPubDir Condition="Exists('..\GearDeck.Widget\bin\x64\$(Configuration)\net8.0-windows\GearDeck.Widget.exe')">..\GearDeck.Widget\bin\x64\$(Configuration)\net8.0-windows\</_WidgetPubDir>
      <_WidgetPubDir Condition="'$(_WidgetPubDir)' == '' and Exists('..\GearDeck.Widget\bin\AnyCPU\$(Configuration)\net8.0-windows\GearDeck.Widget.exe')">..\GearDeck.Widget\bin\AnyCPU\$(Configuration)\net8.0-windows\</_WidgetPubDir>
      <_WidgetPubDir Condition="'$(_WidgetPubDir)' == '' and Exists('..\GearDeck.Widget\bin\$(Configuration)\net8.0-windows\GearDeck.Widget.exe')">..\GearDeck.Widget\bin\$(Configuration)\net8.0-windows\</_WidgetPubDir>
      <_WidgetPubDir Condition="'$(_WidgetPubDir)' == '' and Exists('..\GearDeck.Widget\bin\$(Configuration)\net8.0-windows\win-x64\GearDeck.Widget.exe')">..\GearDeck.Widget\bin\$(Configuration)\net8.0-windows\win-x64\</_WidgetPubDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(_WidgetPubDir)' != ''">
      <_WidgetPubFiles Include="$(_WidgetPubDir)GearDeck.Widget.exe" />
      <_WidgetPubFiles Include="$(_WidgetPubDir)GearDeck.Widget.dll" />
      <_WidgetPubFiles Include="$(_WidgetPubDir)GearDeck.Widget.deps.json" />
      <_WidgetPubFiles Include="$(_WidgetPubDir)GearDeck.Widget.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_WidgetPubFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != '' and !Exists('$(PublishDir)GearDeck.Widget.exe') and '@(_WidgetPubFiles)' != ''" />
  </Target>
</Project>

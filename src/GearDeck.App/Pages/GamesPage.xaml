<Page
    x:Class="GearDeck.App.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GearDeck.App.Controls">
    <Grid x:Name="RootShellGrid" Padding="24,18" RowSpacing="14" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPaneColDef" Width="284" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶部标题与卡片/列表视图切换 -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="游戏与配置切换" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="按本机游戏库规则或全屏独占状态自动切换已唤醒外设的板载槽位与专属预设"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel x:Name="ViewSwitchSlot" Grid.Column="1" VerticalAlignment="Center" />
        </Grid>

        <!-- 左侧常驻栏：自动切换与通知开关 + 实时前台监测 -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="自动切换控制" FontSize="15" FontWeight="SemiBold" />
                        <ToggleSwitch x:Name="AutoSwitchToggle"
                                      Header="启动自动切换"
                                      OnContent="已开启（休眠设备唤醒后自动补切）"
                                      OffContent="已暂停自动切换"
                                      Toggled="OnGlobalSettingsToggled" />
                        <ToggleSwitch x:Name="NotifySwitchToggle"
                                      Header="配置切换 Windows 原生通知"
                                      OnContent="开启切换通知"
                                      OffContent="静默切换"
                                      Toggled="OnGlobalSettingsToggled" />
                        <Button Content="立即检测并应用" HorizontalAlignment="Stretch"
                                Style="{ThemeResource AccentButtonStyle}" Click="OnForceReevaluate" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="实时前台监测" FontSize="15" FontWeight="SemiBold" />
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="ForegroundMonitorText" FontSize="12" Text="当前前台进程：检测中..." TextWrapping="Wrap" />
                                <TextBlock x:Name="ActiveRuleStatusText" FontSize="12" FontWeight="SemiBold" Text="当前生效策略：--" TextWrapping="Wrap" />
                                <TextBlock x:Name="DeviceOutcomeText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧分段标签导航 + 内容区域 -->
        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="TabGamesBtn" Tag="games" CornerRadius="7" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7FC;" FontSize="13" />
                            <TextBlock Text="游戏" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabFullscreenBtn" Tag="fullscreen" CornerRadius="7" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE740;" FontSize="13" />
                            <TextBlock Text="全屏策略" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabPresetsBtn" Tag="presets" CornerRadius="7" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE81E;" FontSize="13" />
                            <TextBlock Text="预设管理" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <InfoBar Grid.Row="1" x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" HorizontalAlignment="Stretch" Padding="0,0,8,24">

                    <!-- ============ TAB 1: 游戏（手动新增 + 本机游戏库 / 单游戏专属配置详情） ============ -->
                    <StackPanel x:Name="PanelGames" Spacing="14" Visibility="Visible">

                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="单游戏配置优先（默认关闭）"
                                 Message="每款游戏的配置默认关闭；在下方卡片开启开关并指派外设预设后，运行该游戏时将以单游戏单独配置优先，自动覆盖「全屏策略」。" />

                        <!-- 视图 A：手动新增 + 本机游戏库 -->
                        <StackPanel x:Name="GamesListView" Spacing="14" Visibility="Visible">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="手动新增到本机游戏库" FontSize="17" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="RunningProcCombo" Grid.Column="0" HorizontalAlignment="Stretch"
                                                  Header="从当前正在运行的应用 / 游戏快速选择" PlaceholderText="点击右侧刷新运行列表..."
                                                  SelectionChanged="OnRunningProcSelected" />
                                        <Button Grid.Column="1" Content="刷新运行列表" VerticalAlignment="Bottom" Click="OnRefreshRunningProcs" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewRuleNameBox" Grid.Column="0" Header="游戏 / 应用名称" PlaceholderText="例如：CS2" />
                                        <TextBox x:Name="NewRuleProcessBox" Grid.Column="1" Header="匹配进程名（多个可用逗号分隔）"
                                                 PlaceholderText="例如：cs2.exe, csgo.exe" />
                                        <Button Grid.Column="2" Content="浏览 .exe..." VerticalAlignment="Bottom" Click="OnBrowseExe" />
                                    </Grid>
                                    <controls:ResponsiveWrapPanel Spacing="12" LineSpacing="8">
                                        <Button Content="+ 添加到本机游戏库" Style="{ThemeResource AccentButtonStyle}" Click="OnAddManualGame" />
                                        <TextBlock Text="添加后将显示在下方本机游戏库中，点击该游戏的「游戏配置」即可设置专属外设参数。"
                                                   VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </controls:ResponsiveWrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="本机游戏库" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock x:Name="ScannedGamesHint"
                                                       Text="正在扫描 Steam / Epic / Riot / WeGame / HoYoPlay / Battle.net / Xbox 游戏，点击「游戏配置」进入专属设置"
                                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBox x:Name="GameFilterBox" PlaceholderText="搜索游戏、平台或 .exe..." Width="210" TextChanged="OnGameFilterChanged" />
                                            <Button x:Name="ScanGamesBtn" Content="重新扫描" Style="{ThemeResource AccentButtonStyle}" Click="OnScanInstalledGames" />
                                        </StackPanel>
                                    </Grid>
                                    <controls:ResponsiveItemsHost x:Name="ScannedGamesHost" MinCardWidth="280" Gap="10" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 视图 B：点击某款游戏的「游戏配置」后进入该游戏专属设置 -->
                        <StackPanel x:Name="GameExclusiveDetailView" Spacing="14" Visibility="Collapsed">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BackToLibraryBtn" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                            <TextBlock Text="返回本机游戏库" />
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <Grid x:Name="ExclusiveIconHost" />
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="ExclusiveGameTitleText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="ExclusiveGameSubText" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ToggleSwitch Grid.Column="2" x:Name="ExclusiveRuleEnableToggle"
                                                  OnContent="已开启" OffContent="已关闭"
                                                  MinWidth="0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="该游戏专属外设切换设置" FontSize="17" FontWeight="SemiBold" />
                                    <TextBox x:Name="ExclusiveProcessBox" Header="匹配进程名（多个可用逗号分隔，失焦自动保存）"
                                             PlaceholderText="例如：cs2.exe, csgo.exe" />
                                    <CheckBox x:Name="ExclusiveRequireFsCheck" Content="仅当该游戏处于全屏 / 独占全屏状态时触发" />
                                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <TextBlock Text="每台外设的专属目标槽位 / 预设" FontSize="14" FontWeight="SemiBold" />
                                    <StackPanel x:Name="ExclusiveTargetsPanel" Spacing="10" />
                                    <controls:ResponsiveWrapPanel Spacing="10" LineSpacing="8">
                                        <Button x:Name="ExclusiveApplyNowBtn" Content="立即套用此游戏配置" Style="{ThemeResource AccentButtonStyle}" />
                                        <Button x:Name="ExclusiveResetBtn" Content="清空此游戏专属配置" />
                                        <Button x:Name="ExclusiveRemoveManualBtn" Content="从游戏库移除" Visibility="Collapsed" />
                                    </controls:ResponsiveWrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============ TAB 2: 全屏策略 ============ -->
                    <StackPanel x:Name="PanelFullscreen" Spacing="14" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="14">
                                <controls:ResponsiveWrapPanel Spacing="24" LineSpacing="8">
                                    <StackPanel Spacing="2" MinWidth="280">
                                        <TextBlock Text="全屏独占与退出恢复策略" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="打开全局独占策略总开关后可更改并生效下方独占与退出恢复规则，关闭时均不生效。"
                                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="FullscreenMasterToggle"
                                                  Header="全局独占策略总开关"
                                                  OnContent="已开启（允许更改并生效下方全屏独占策略）"
                                                  OffContent="已关闭（默认不生效，下方全屏独占策略已锁定）"
                                                  Toggled="OnFullscreenMasterToggled" />
                                </controls:ResponsiveWrapPanel>
                                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                                         Title="优先级提醒：单游戏单独配置优先"
                                         Message="若某款游戏已在「游戏」标签页开启开关并设置了外设预设（或设为保持不变），运行该游戏时将以单游戏配置优先，自动覆盖此处的全屏独占策略。" />
                                <controls:ResponsiveItemsHost x:Name="StrategyCardsHost" MinCardWidth="380" Gap="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ TAB 3: 预设管理 ============ -->
                    <StackPanel x:Name="PanelPresets" Spacing="14" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="厂家板载预设读取与分硬件参数预设库" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="可直接读取每台硬件自身存储的厂家板载预设（写入游戏规则下拉），也可在此抓存新的专属预设。"
                                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <controls:ResponsiveItemsHost x:Name="DevicePresetsQuickHost" MinCardWidth="290" Gap="10" />
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CaptureMouseCombo" Grid.Column="0" HorizontalAlignment="Stretch" Header="目标硬件" />
                                    <TextBox x:Name="PresetNameBox" Grid.Column="1" Header="新预设名称" PlaceholderText="例如：FPS 800 DPI 4K / 桌面节能" />
                                    <Button x:Name="CapturePresetBtn" Grid.Column="2" Content="保存至该设备预设" VerticalAlignment="Bottom"
                                            Style="{ThemeResource AccentButtonStyle}" Click="OnCapturePreset" />
                                </Grid>
                                <controls:ResponsiveItemsHost x:Name="PresetsHost" MinCardWidth="270" Gap="10" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

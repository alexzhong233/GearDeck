<Page
    x:Class="GearDeck.App.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GearDeck.App.Controls">
    <ScrollViewer Padding="24,20">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="游戏与进程配置自动切换" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="集成 OpenMouse 游戏签名目录扫描本机游戏库；仅向当前唤醒外设写入配置，全屏未退出时支持保持不回切"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel x:Name="ViewSwitchSlot" Grid.Column="1" VerticalAlignment="Center" />
            </Grid>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <!-- 1. 总开关、通知开关与实时监控状态 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <controls:ResponsiveWrapPanel Spacing="24" LineSpacing="10">
                        <ToggleSwitch x:Name="AutoSwitchToggle"
                                      Header="启用游戏 / 进程 / 独占全屏自动切换"
                                      OnContent="已启用（仅切换唤醒设备，休眠设备唤醒后自动补切）"
                                      OffContent="已暂停自动切换"
                                      Toggled="OnGlobalSettingsToggled" />
                        <ToggleSwitch x:Name="NotifySwitchToggle"
                                      Header="配置切换 Windows 原生通知"
                                      OnContent="切换生效时通知哪个设备切到了什么预设"
                                      OffContent="静默切换（不弹窗通知）"
                                      Toggled="OnGlobalSettingsToggled" />
                        <Button Content="立即检测并应用" VerticalAlignment="Bottom"
                                Style="{ThemeResource AccentButtonStyle}" Click="OnForceReevaluate" />
                    </controls:ResponsiveWrapPanel>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ForegroundMonitorText" FontSize="13" Text="当前前台进程：检测中..." TextWrapping="Wrap" />
                            <TextBlock x:Name="ActiveRuleStatusText" FontSize="13" FontWeight="SemiBold" Text="当前生效策略：--" TextWrapping="Wrap" />
                            <TextBlock x:Name="DeviceOutcomeText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. 本机游戏库（默认收起，支持展开收起与快速扫描） -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="本机游戏库" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="ScannedGamesHint"
                                       Text="后台扫描 Steam / Epic / Riot / WeGame / HoYoPlay / Battle.net / Xbox 游戏，点击右侧可展开"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <controls:ResponsiveWrapPanel Grid.Column="1" Spacing="8" LineSpacing="6" VerticalAlignment="Center">
                            <Button x:Name="ToggleGameLibraryBtn" Content="展开游戏库 ▾" Click="OnToggleGameLibrary" />
                            <Button x:Name="ScanGamesBtn" Content="扫描本机游戏" Style="{ThemeResource AccentButtonStyle}" Click="OnScanInstalledGames" />
                        </controls:ResponsiveWrapPanel>
                    </Grid>
                    <StackPanel x:Name="GameLibraryBody" Spacing="10" Visibility="Collapsed">
                        <controls:ResponsiveWrapPanel Spacing="10" LineSpacing="8">
                            <TextBox x:Name="GameFilterBox" PlaceholderText="搜索游戏名称、平台或 .exe..." Width="240" TextChanged="OnGameFilterChanged" />
                        </controls:ResponsiveWrapPanel>
                        <controls:ResponsiveItemsHost x:Name="ScannedGamesHost" MinCardWidth="270" Gap="10" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 手动新建与已配置游戏规则 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="手动新增游戏 / 进程规则" FontSize="18" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="RunningProcCombo" Grid.Column="0" HorizontalAlignment="Stretch"
                                  Header="从当前正在运行的应用/游戏选择" PlaceholderText="点击右侧刷新运行列表..."
                                  SelectionChanged="OnRunningProcSelected" />
                        <Button Grid.Column="1" Content="刷新运行列表" VerticalAlignment="Bottom" Click="OnRefreshRunningProcs" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewRuleNameBox" Grid.Column="0" Header="规则名称" PlaceholderText="例如：CS2 竞技" />
                        <TextBox x:Name="NewRuleProcessBox" Grid.Column="1" Header="匹配进程名（多个可用逗号分隔）"
                                 PlaceholderText="例如：cs2.exe, csgo.exe" />
                        <Button Grid.Column="2" Content="浏览 .exe..." VerticalAlignment="Bottom" Click="OnBrowseExe" />
                    </Grid>
                    <controls:ResponsiveWrapPanel Spacing="16" LineSpacing="8">
                        <CheckBox x:Name="NewRuleRequireFsCheck" Content="仅当该应用处于全屏/独占全屏状态时触发" />
                        <Button Content="+ 添加游戏规则" Style="{ThemeResource AccentButtonStyle}" Click="OnAddRule" />
                    </controls:ResponsiveWrapPanel>
                </StackPanel>
            </Border>

            <!-- 4. 进程规则列表 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="已配置的游戏 / 进程规则（下拉自动列出每台设备的厂家板载配置与专属预设）"
                               FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="NoRulesHint" Text="暂无自定义进程规则，可在上方游戏库一键添加或手动录入 .exe。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:ResponsiveItemsHost x:Name="RulesHost" MinCardWidth="420" Gap="12" />
                </StackPanel>
            </Border>

            <!-- 5. 合并：全屏独占与退出保持策略（卡片式列表：描述 + 下拉 + 逐设备指派） -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="14">
                    <controls:ResponsiveWrapPanel Spacing="24" LineSpacing="8">
                        <StackPanel Spacing="2" MinWidth="280">
                            <TextBlock Text="全屏独占与退出恢复策略" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="打开全盘独占策略总开关后可更改并生效下方独占规则，关闭时默认不生效。"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FullscreenMasterToggle"
                                      Header="全盘独占策略总开关"
                                      OnContent="已开启（允许更改并生效下方全屏独占策略）"
                                      OffContent="已关闭（默认不生效，下方全屏独占策略已锁定）"
                                      Toggled="OnFullscreenMasterToggled" />
                    </controls:ResponsiveWrapPanel>
                    <controls:ResponsiveItemsHost x:Name="StrategyCardsHost" MinCardWidth="380" Gap="12" />
                </StackPanel>
            </Border>

            <!-- 6. 各硬件厂家板载预设读取 & 本设备预设管理 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="厂家板载预设读取与分硬件参数预设库" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="可直接读取每台硬件自身存储的厂家板载预设（写入下方规则下拉），也可在对应设备详情页或此处抓存专属预设。"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <controls:ResponsiveItemsHost x:Name="DevicePresetsQuickHost" MinCardWidth="290" Gap="10" />
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CaptureMouseCombo" Grid.Column="0" HorizontalAlignment="Stretch" Header="目标硬件" />
                        <TextBox x:Name="PresetNameBox" Grid.Column="1" Header="新预设名称" PlaceholderText="例如：FPS 800 DPI 4K / 桌面节能" />
                        <Button x:Name="CapturePresetBtn" Grid.Column="2" Content="保存至该设备预设" VerticalAlignment="Bottom"
                                Style="{ThemeResource AccentButtonStyle}" Click="OnCapturePreset" />
                    </Grid>
                    <controls:ResponsiveItemsHost x:Name="PresetsHost" MinCardWidth="270" Gap="10" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

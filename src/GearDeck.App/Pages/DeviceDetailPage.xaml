<Page
    x:Class="GearDeck.App.Pages.DeviceDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GearDeck.App.Controls">
    <ScrollViewer Padding="24,20">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock x:Name="TitleText" Text="设备" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 顶部设备总览卡 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="AvatarHost" Grid.Column="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="StateText" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="NoteText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="BatteryText" Text="--" FontSize="40" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <controls:ResponsiveWrapPanel Spacing="10" LineSpacing="8">
                        <Button x:Name="ReadCapsBtn" Content="读取当前硬件参数" Click="OnRetryProbe" />
                        <Button Content="立即刷新电量" Click="OnRefresh" />
                        <Button Content="更换设备图片" Click="OnPickDeviceImage" />
                        <Button Content="在任务栏显示此设备" Click="OnPinToTaskbar" />
                        <ProgressRing x:Name="BusyRing" IsActive="False" Width="22" Height="22" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </controls:ResponsiveWrapPanel>
                </StackPanel>
            </Border>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <!-- 0. 本设备独立低电量提醒设置卡（所有带电量外设通用） -->
            <Border x:Name="LowBatteryPolicyCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="本设备独立低电量提醒" FontSize="18" FontWeight="SemiBold" />
                    <controls:ResponsiveWrapPanel Spacing="24" LineSpacing="8">
                        <ToggleSwitch x:Name="DeviceLowBatEnableSwitch" Header="启用此设备低电量提醒"
                                      OnContent="开启" OffContent="关闭" Toggled="OnDeviceLowBatPolicyChanged" />
                        <ToggleSwitch x:Name="DeviceLowBatCustomSwitch" Header="阈值模式"
                                      OnContent="独立自定义阈值" OffContent="跟随设置页全局阈值"
                                      Toggled="OnDeviceLowBatPolicyChanged" />
                        <ToggleSwitch x:Name="DeviceLowBatNotifySwitch" Header="Windows 原生弹窗通知"
                                      OnContent="低电量时通知提醒" OffContent="仅任务栏标红"
                                      Toggled="OnDeviceLowBatPolicyChanged" />
                    </controls:ResponsiveWrapPanel>
                    <Grid x:Name="DeviceLowBatThresholdRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="DeviceLowBatSlider" Grid.Column="0" Header="本设备专属低电量阈值 (%)"
                                Maximum="80" Minimum="0" StepFrequency="1"
                                ValueChanged="OnDeviceLowBatSliderChanged" />
                        <TextBlock x:Name="DeviceLowBatValueText" Grid.Column="1" VerticalAlignment="Bottom"
                                   Margin="0,0,0,10" MinWidth="120" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 1. 厂家板载配置与本设备专属预设卡 -->
            <Border x:Name="ProfileCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="厂家板载预设与本设备配置库" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="ProbeAllSlotsBtn" Grid.Column="1" Content="读取厂家全部板载预设"
                                Click="OnProbeAllOnboardSlots" Visibility="Collapsed" />
                    </Grid>

                    <StackPanel x:Name="OnboardProfileSection" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="厂家硬件板载槽位（点击立即切换；读取后可在游戏规则下拉中直接选用）" FontSize="12"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <controls:ResponsiveWrapPanel x:Name="OnboardProfileButtonsPanel" Spacing="8" LineSpacing="8" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="10">
                        <TextBlock Text="本设备专属软件预设（直接在本硬件页面保存/写入，亦供游戏自动切换）" FontWeight="SemiBold" />
                        <Grid x:Name="SavePresetSection" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SavePresetNameBox" Grid.Column="0" PlaceholderText="输入预设名称（如：CS2 800DPI 4K / 桌面节能），将抓取当前硬件参数" />
                            <Button x:Name="SaveDevicePresetBtn" Grid.Column="1" Content="保存当前参数到本设备"
                                    Style="{ThemeResource AccentButtonStyle}" Click="OnSaveAsGamePreset" />
                        </Grid>
                        <StackPanel x:Name="DeviceSavedPresetsPanel" Spacing="8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. 控制模式（罗技 板载 vs 主机软件模式） -->
            <Border x:Name="HostModeCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="运行模式（板载内存 / 主机接管）" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="处于板载内存模式时可使用内置的 1~5 号配置文件；开启主机接管可自由写入实时参数。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Name="HostModeSwitch"
                                  OnContent="主机软件接管（允许实时调参）"
                                  OffContent="板载内存模式（使用 built-in 配置文件）"
                                  Toggled="OnHostModeToggled" />
                </StackPanel>
            </Border>

            <!-- 3. DPI 灵敏度卡 -->
            <Border x:Name="DpiCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="DPI 灵敏度与板载档位" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="DpiSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SyncXySwitch" Grid.Column="1" VerticalAlignment="Center"
                                      OnContent="XY 同步调节" OffContent="XY 独立调节"
                                      Toggled="OnSyncXyToggled" />
                    </Grid>

                    <StackPanel x:Name="DpiStagesSection" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="多档位 DPI（点击档位立即切换，编辑下方数值后点击写入可更新当前档位）"
                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <controls:ResponsiveWrapPanel x:Name="DpiStagesPanel" Spacing="8" LineSpacing="8" />
                        <controls:ResponsiveWrapPanel Spacing="8" LineSpacing="8">
                            <Button x:Name="AddStageBtn" Content="+ 添加档位" Click="OnAddStage" />
                            <Button x:Name="RemoveStageBtn" Content="- 删除末档" Click="OnRemoveStage" />
                        </controls:ResponsiveWrapPanel>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock x:Name="DpiXLabel" Text="水平灵敏度 (X / 主 DPI)" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="DpiXSlider" Grid.Column="0" Maximum="32000" Minimum="0" StepFrequency="50"
                                    VerticalAlignment="Center" ValueChanged="OnDpiXSliderChanged" />
                            <NumberBox x:Name="DpiXBox" Grid.Column="1" Width="168" Maximum="32000" Minimum="0"
                                       SmallChange="50" LargeChange="400" SpinButtonPlacementMode="Inline"
                                       VerticalAlignment="Center" ValueChanged="OnDpiXBoxChanged" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="DpiYSection" Visibility="Collapsed" Spacing="4">
                        <TextBlock Text="垂直灵敏度 (Y DPI)" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="DpiYSlider" Grid.Column="0" Maximum="32000" Minimum="0" StepFrequency="50"
                                    VerticalAlignment="Center" ValueChanged="OnDpiYSliderChanged" />
                            <NumberBox x:Name="DpiYBox" Grid.Column="1" Width="168" Maximum="32000" Minimum="0"
                                       SmallChange="50" LargeChange="400" SpinButtonPlacementMode="Inline"
                                       VerticalAlignment="Center" ValueChanged="OnDpiYBoxChanged" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="常用 DPI 快捷切换（点击立即写入鼠标）" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <controls:ResponsiveWrapPanel x:Name="DpiPresetsPanel" Spacing="8" LineSpacing="8" />
                    </StackPanel>

                    <controls:ResponsiveWrapPanel Spacing="12" LineSpacing="8">
                        <Button x:Name="ApplyDpiBtn" Content="应用 DPI 设置" Style="{ThemeResource AccentButtonStyle}" Click="OnApplyDpi" />
                        <TextBlock x:Name="DpiRangeHint" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </controls:ResponsiveWrapPanel>
                </StackPanel>
            </Border>

            <!-- 4. 回报率卡片 -->
            <Border x:Name="RateCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="回报率（Polling Rate）" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="点击目标频率即可立即写入鼠标硬件；2000~8000 Hz 高回报率需匹配高速接收器或有线。"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <controls:ResponsiveWrapPanel x:Name="RatePanel" Spacing="8" LineSpacing="8" />
                </StackPanel>
            </Border>

            <!-- 5. 性能/扳机模式与传感器开关卡片 -->
            <Border x:Name="ModeCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="性能 / 力反馈模式与传感器开关" FontSize="18" FontWeight="SemiBold" />

                    <StackPanel x:Name="PerfModeSection" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="运行模式（点击立即切换）" FontWeight="SemiBold" />
                        <controls:ResponsiveWrapPanel x:Name="PerfModePanel" Spacing="8" LineSpacing="8" />
                        <TextBlock x:Name="PerfModeDescText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <controls:ResponsiveWrapPanel Spacing="24" LineSpacing="10">
                        <ToggleSwitch x:Name="MotionSyncSwitch" Visibility="Collapsed"
                                      Header="移动同步 (Motion Sync)" OnContent="开启" OffContent="关闭"
                                      Toggled="OnMotionSyncToggled" />
                        <ToggleSwitch x:Name="AngleSnapSwitch" Visibility="Collapsed"
                                      Header="直线修正 (Angle Snapping)" OnContent="开启" OffContent="关闭"
                                      Toggled="OnAngleSnapToggled" />
                        <ToggleSwitch x:Name="RippleSwitch" Visibility="Collapsed"
                                      Header="波纹修正 (Ripple Control)" OnContent="开启" OffContent="关闭"
                                      Toggled="OnRippleToggled" />
                        <ToggleSwitch x:Name="LongRangeSwitch" Visibility="Collapsed"
                                      Header="无线抗干扰远距增强 (Long Range)" OnContent="开启" OffContent="关闭"
                                      Toggled="OnLongRangeToggled" />
                    </controls:ResponsiveWrapPanel>
                </StackPanel>
            </Border>

            <!-- 6. 传感器微调（LOD / 非对称高度 / 角度校准 / 按键防抖）与电源设置 -->
            <Border x:Name="AdvancedCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="传感器微调、按键防抖与休眠电源" FontSize="18" FontWeight="SemiBold" />

                    <StackPanel x:Name="LodSection" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="静默高度 / 响应距离（LOD，点击立即写入）" FontWeight="SemiBold" />
                        <controls:ResponsiveWrapPanel x:Name="LodButtonsPanel" Spacing="8" LineSpacing="8" />
                    </StackPanel>

                    <StackPanel x:Name="AsymLodSection" Visibility="Collapsed" Spacing="8">
                        <ToggleSwitch x:Name="AsymLodSwitch"
                                      Header="Razer 非对称中止高度调节 (Asymmetric Cut-off)"
                                      OnContent="开启非对称抬起/着陆高度" OffContent="使用对称 LOD" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="AsymLiftSlider" Grid.Column="0" Header="抬起断开高度 (Lift-off, 2~26)"
                                    Maximum="26" Minimum="0" StepFrequency="1" ValueChanged="OnAsymSliderChanged" />
                            <TextBlock x:Name="AsymLiftText" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,10" MinWidth="70" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="AsymLandSlider" Grid.Column="0" Header="着陆恢复高度 (Landing, 须小于抬起高度)"
                                    Maximum="25" Minimum="0" StepFrequency="1" ValueChanged="OnAsymSliderChanged" />
                            <TextBlock x:Name="AsymLandText" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,10" MinWidth="70" />
                        </Grid>
                        <Button Content="应用非对称高度" Click="OnApplyAsymLod" />
                    </StackPanel>

                    <StackPanel x:Name="DebounceSection" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="主键防抖延迟（Debounce Time）" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="DebounceSlider" Grid.Column="0" Maximum="30" Minimum="0" StepFrequency="1"
                                    ValueChanged="OnDebounceSliderChanged" />
                            <TextBlock x:Name="DebounceValueText" Grid.Column="1" VerticalAlignment="Center" MinWidth="64" />
                            <Button Grid.Column="2" Content="写入防抖" Click="OnApplyDebounce" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AngleTuningSection" Visibility="Collapsed" Spacing="6">
                        <TextBlock Text="传感器角度校准（Angle Tuning, -30° ~ +30°）" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="AngleSlider" Grid.Column="0" Maximum="30" Minimum="0" StepFrequency="1"
                                    ValueChanged="OnAngleSliderChanged" />
                            <TextBlock x:Name="AngleValueText" Grid.Column="1" VerticalAlignment="Center" MinWidth="64" />
                            <Button Grid.Column="2" Content="写入角度" Click="OnApplyAngle" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="DiscreteSleepSection" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="无线自动休眠时间（点击立即写入）" FontWeight="SemiBold" />
                        <controls:ResponsiveWrapPanel x:Name="DiscreteSleepPanel" Spacing="8" LineSpacing="8" />
                    </StackPanel>

                    <StackPanel x:Name="SleepSection" Visibility="Collapsed" Spacing="4">
                        <TextBlock Text="无线自动休眠时间" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SleepSlider" Grid.Column="0" Maximum="30" Minimum="0" StepFrequency="1"
                                    ValueChanged="OnSleepSliderChanged" />
                            <TextBlock x:Name="SleepValueText" Grid.Column="1" VerticalAlignment="Center" MinWidth="120" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="LowBatWarnSection" Visibility="Collapsed" Spacing="4">
                        <TextBlock Text="鼠标固件内建低电量 LED 警告阈值" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="LowBatSlider" Grid.Column="0" Maximum="50" Minimum="0" StepFrequency="1"
                                    ValueChanged="OnLowBatSliderChanged" />
                            <TextBlock x:Name="LowBatValueText" Grid.Column="1" VerticalAlignment="Center" MinWidth="120" />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="ApplyPowerBtn" Visibility="Collapsed" Content="应用电源与休眠设置"
                            Style="{ThemeResource AccentButtonStyle}" Click="OnApplyPower" />
                </StackPanel>
            </Border>

            <!-- 7. 原生按键重映射与宏绑定快捷卡 -->
            <Border x:Name="MacroAndButtonsCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="原生按键重映射与宏绑定" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="MacroNoteText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="前往「鼠标宏中心」录制/管理宏 →"
                                Style="{ThemeResource AccentButtonStyle}" Click="OnOpenMacroHub" />
                    </Grid>

                    <StackPanel x:Name="ButtonBindingsSection" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="鼠标按键板载映射（写入鼠标自身内存，脱离软件同样生效）" FontWeight="SemiBold" />
                        <StackPanel x:Name="ButtonBindingsPanel" Spacing="8" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <!-- 将「鼠标宏中心」已录制的宏一键录入到此设备 -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="将宏库动作绑定 / 录入到此设备" FontWeight="SemiBold" />
                        <controls:ResponsiveWrapPanel Spacing="10" LineSpacing="8">
                            <ComboBox x:Name="QuickMacroCombo" Header="选择在「鼠标宏中心」录制的宏" MinWidth="220" />
                            <ComboBox x:Name="QuickMacroBtnCombo" Header="目标物理按键" MinWidth="180" />
                            <Button Content="录入 / 绑定此宏" VerticalAlignment="Bottom" Click="OnQuickEnrollMacro" />
                        </controls:ResponsiveWrapPanel>
                        <StackPanel x:Name="DeviceMacroBindingsSummary" Spacing="4" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 8. 休眠 / 未开放协议提示卡 -->
            <Border x:Name="FallbackCard" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="FallbackTitle" Text="设备参数状态" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="FallbackMessage" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="重新读取硬件参数" HorizontalAlignment="Left" Click="OnRetryProbe" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

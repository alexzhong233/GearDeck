<Page
    x:Class="GearDeck.App.Pages.DeviceDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GearDeck.App.Controls">

    <Grid x:Name="RootShellGrid" Padding="24,18,24,20" RowSpacing="14" ColumnSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="HeroColumnDef" Width="284" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶部导航面包屑与标题条 -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackBtn" ToolTipService.ToolTip="返回设备总览">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                    <TextBlock Text="设备总览" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="SubtitleText" Text="外设详情" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TitleText" Text="设备名称" FontSize="22" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="22" Height="22" Visibility="Collapsed" />
                <Button x:Name="ReadCapsBtn" Content="重新读取设备参数" />
            </StackPanel>
        </Grid>

        <!-- 左侧硬件 Hero 栏 -->
        <ScrollViewer x:Name="LeftHeroPane" Grid.Row="1" Grid.Column="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Spacing="14">
                        <Border Height="196" CornerRadius="10"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid x:Name="AvatarHost" Padding="12" />
                        </Border>

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="StateText" Text="已连接" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="BatteryText" Text="" FontSize="18" FontWeight="Bold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="NoteText" Text="" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Button x:Name="LocalDriverBtn" HorizontalAlignment="Stretch" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE713;" FontSize="13" />
                                    <TextBlock x:Name="LocalDriverBtnText" Text="打开本地驱动" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WebDriverBtn" HorizontalAlignment="Stretch" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE774;" FontSize="13" />
                                    <TextBlock x:Name="WebDriverBtnText" Text="打开网页驱动" />
                                </StackPanel>
                            </Button>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PickImageBtn" Grid.Column="0" Content="更换设备图" HorizontalAlignment="Stretch" />
                                <Button x:Name="PinTaskbarBtn" Grid.Column="1" Content="固定到任务栏" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 硬件状态概览（常驻左侧） -->
                <Border x:Name="OverviewSummaryCard"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="硬件状态概览" FontSize="15" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8" Padding="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="电量 / 充电" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="OverviewBatteryText" Text="-" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8" Padding="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="DPI / 回报率" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="OverviewPerfText" Text="-" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8" Padding="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="协议与特征" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="OverviewProtocolText" Text="-" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 与原生驱动共存退让提示 -->
                <InfoBar x:Name="CoexistenceBanner"
                         IsOpen="False" IsClosable="False" Severity="Informational"
                         Title="已自动退让控制权">
                    <StackPanel Spacing="8" Margin="0,0,0,4">
                        <TextBlock x:Name="CoexistenceText" FontSize="12" TextWrapping="Wrap"
                                   Text="检测到官方桌面驱动或网页驱动正在前台/刚启动，GearDeck 已暂停后台轮询以避免抢占。" />
                        <Button x:Name="ResumeCoexistenceBtn" Content="立即恢复 GearDeck 同步" />
                    </StackPanel>
                </InfoBar>
            </StackPanel>
        </ScrollViewer>

        <!-- 右侧顶部配置文件快切栏 + 三标签页 + 滚动内容 -->
        <Grid x:Name="RightContentPane" Grid.Row="1" Grid.Column="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 独立于性能/RT/高级之上的顶部配置文件快切栏 -->
            <Border x:Name="TopProfileBarCard" Grid.Row="0" Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="配置文件" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel x:Name="OnboardProfileSection" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center">
                                <controls:ResponsiveWrapPanel x:Name="OnboardProfileButtonsPanel" Spacing="6" LineSpacing="6" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button x:Name="ProbeAllSlotsBtn" Content="扫描板载槽位" Padding="10,5" FontSize="12" Visibility="Collapsed" />
                            <StackPanel x:Name="HostModeCard" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock Text="运行模式:" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ToggleSwitch x:Name="HostModeSwitch" OnContent="板载内存" OffContent="G HUB 宿主"
                                              MinWidth="0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="SavePresetSection" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="SavePresetNameBox" PlaceholderText="保存当前参数为快速预设（如：CS2 / 办公）" Width="250" />
                            <Button x:Name="SaveDevicePresetBtn" Style="{ThemeResource AccentButtonStyle}" Content="保存预设" />
                        </StackPanel>
                        <controls:ResponsiveWrapPanel x:Name="DeviceSavedPresetsPanel" Spacing="8" LineSpacing="6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 分段标签导航条（性能 / 按键 & RT / 高级） -->
            <Border Grid.Row="1" HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="TabPerfBtn" Tag="perf" CornerRadius="7" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE945;" FontSize="13" />
                            <TextBlock Text="性能" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabButtonsBtn" Tag="buttons" CornerRadius="7" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE765;" FontSize="13" />
                            <TextBlock Text="按键 &amp; RT" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabAdvancedBtn" Tag="advanced" CornerRadius="7" Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE90F;" FontSize="13" />
                            <TextBlock Text="高级" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <InfoBar Grid.Row="2" x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" HorizontalAlignment="Stretch" Padding="0,0,8,24">

                    <!-- 兜底提示卡（休眠或只读/未知协议设备） -->
                    <Border x:Name="FallbackCard" Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="FallbackTitle" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="FallbackMessage" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- ============ TAB 1: 性能 ============ -->
                    <StackPanel x:Name="PanelPerf" Spacing="14" Visibility="Visible">
                        <!-- DPI 与档位 -->
                        <Border x:Name="DpiCard" Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="DPI 档位与实时灵敏度" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DpiSummaryText" Text="" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SyncXySwitch" HorizontalAlignment="Right"
                                                  Header="同步 X/Y 轴" IsOn="True" Visibility="Collapsed" />
                                </Grid>

                                <StackPanel x:Name="DpiStagesSection" Spacing="8" Visibility="Collapsed">
                                    <Grid>
                                        <TextBlock Text="当前设备 DPI 档位（点击切换，拖动滑块或输入数值实时下发）"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button x:Name="AddStageBtn" Content="+ 增加档位" />
                                            <Button x:Name="RemoveStageBtn" Content="- 减少档位" />
                                        </StackPanel>
                                    </Grid>
                                    <controls:ResponsiveWrapPanel x:Name="DpiStagesPanel" Spacing="8" LineSpacing="6" />
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DpiXLabel" Text="DPI:" VerticalAlignment="Center" MinWidth="44" />
                                    <Slider Grid.Column="1" x:Name="DpiXSlider"
                                            Maximum="30000" Minimum="0" StepFrequency="50" />
                                    <NumberBox Grid.Column="2" x:Name="DpiXBox" Width="138"
                                               Maximum="45000" Minimum="0" SpinButtonPlacementMode="Compact" />
                                </Grid>

                                <Grid x:Name="DpiYSection" ColumnSpacing="12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Y 轴:" VerticalAlignment="Center" MinWidth="44" />
                                    <Slider Grid.Column="1" x:Name="DpiYSlider"
                                            Maximum="30000" Minimum="0" StepFrequency="50" />
                                    <NumberBox Grid.Column="2" x:Name="DpiYBox" Width="138"
                                               Maximum="45000" Minimum="0" SpinButtonPlacementMode="Compact" />
                                </Grid>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="常用快捷键" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <controls:ResponsiveWrapPanel x:Name="DpiPresetsPanel" Spacing="8" LineSpacing="6" />
                                </StackPanel>

                                <TextBlock x:Name="DpiRangeHint" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 回报率 -->
                        <Border x:Name="RateCard" Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="无线 / 有线回报率" FontSize="17" FontWeight="SemiBold" />
                                <controls:ResponsiveWrapPanel x:Name="RatePanel" Spacing="8" LineSpacing="6" />
                            </StackPanel>
                        </Border>

                        <!-- 性能模式与传感器增强 -->
                        <Border x:Name="ModeCard" Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="性能模式与传感器增强" FontSize="17" FontWeight="SemiBold" />
                                <StackPanel x:Name="PerfModeSection" Spacing="6" Visibility="Collapsed">
                                    <controls:ResponsiveWrapPanel x:Name="PerfModePanel" Spacing="8" LineSpacing="6" />
                                    <TextBlock x:Name="PerfModeDescText" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <controls:ResponsiveWrapPanel Spacing="20" LineSpacing="8">
                                    <ToggleSwitch x:Name="MotionSyncSwitch" Header="Motion Sync" Visibility="Collapsed" />
                                    <ToggleSwitch x:Name="AngleSnapSwitch" Header="直线修正" Visibility="Collapsed" />
                                    <ToggleSwitch x:Name="RippleSwitch" Header="波纹控制" Visibility="Collapsed" />
                                    <ToggleSwitch x:Name="LongRangeSwitch" Header="远距离增强 (HP)" Visibility="Collapsed" />
                                </controls:ResponsiveWrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ TAB 3: 按键 & RT ============ -->
                    <StackPanel x:Name="PanelButtons" Spacing="14" Visibility="Collapsed">
                        <!-- HITS / AULA SSHS 2.0 触发与 Rapid Trigger 卡片（参考 G HUB PRO X3 SUPERSTRIKE） -->
                        <Border x:Name="AnalogSwitchCard" Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="AnalogTechTitle" Text="HITS Tuning" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AnalogModeDescText"
                                                   Text="两个主按键：将相同数值实时应用到左右两个主微动"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button x:Name="AnalogLinkBothBtn" Content="两个按键" />
                                        <Button x:Name="AnalogIndepBtn" Content="独立" />
                                    </StackPanel>
                                </Grid>

                                <!-- Left / Right 10 格可视化进度条 + 实时按压测试区 -->
                                <StackPanel x:Name="AnalogVisualBarsPanel" Spacing="8" />
                                <Border x:Name="AnalogPressTestPad"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="在此区域按住左键 / 右键实时测试按压力度与 RT 动态触发（右键已屏蔽系统菜单）"
                                                   FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" x:Name="AnalogLiveStateText" Text="待按压测试"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Border>

                                <!-- 独立模式下选择左/右键 -->
                                <StackPanel x:Name="AnalogSideSelectorPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                    <Button x:Name="AnalogSelectLeftBtn" Content="左主按键 (Left)" />
                                    <Button x:Name="AnalogSelectRightBtn" Content="右主按键 (Right)" />
                                </StackPanel>

                                <!-- 触发点 1..10 -->
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="触发点" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock x:Name="AnalogActValueText" Text="1 次短按 — 10 次长按"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Slider x:Name="AnalogActSlider" Width="210" HorizontalAlignment="Right"
                                                Maximum="10" Minimum="1" StepFrequency="1" Value="4" />
                                    </Grid>
                                    <controls:ResponsiveWrapPanel x:Name="AnalogActuationPanel" Spacing="6" LineSpacing="6" />
                                </StackPanel>

                                <!-- Rapid Trigger 关 / 开 + 1..5 -->
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Rapid Trigger" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="1 快 — 5 慢（动态抬起重置行程）"
                                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <Button x:Name="AnalogRtOffBtn" Content="关" MinWidth="54" />
                                            <Button x:Name="AnalogRtOnBtn" Content="开" MinWidth="54" />
                                        </StackPanel>
                                    </Grid>
                                    <controls:ResponsiveWrapPanel x:Name="AnalogRtPanel" Spacing="6" LineSpacing="6" />
                                </StackPanel>

                                <!-- 点击触感：支持罗技 0..5 挡位与狼蛛 开关 + 0..100 震动强度 -->
                                <StackPanel x:Name="AnalogHapSection" Spacing="8">
                                    <StackPanel>
                                        <TextBlock Text="点击触感 / 反馈" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="0 关闭 — 5 最大反馈（部分型号支持 0-100 无极调节）"
                                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <controls:ResponsiveWrapPanel x:Name="AnalogHapDiscretePanel" Spacing="6" LineSpacing="6" />
                                    <StackPanel x:Name="AnalogHapSliderPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                                        <Button x:Name="AnalogHapOffBtn" Content="关" MinWidth="54" />
                                        <Button x:Name="AnalogHapOnBtn" Content="开" MinWidth="54" />
                                        <Slider x:Name="AnalogHapSlider" Width="220"
                                                Maximum="100" Minimum="0" StepFrequency="5" Value="50" />
                                        <TextBlock x:Name="AnalogHapValueText" Text="50%" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" MinWidth="44" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="ApplyAnalogBtn" Style="{ThemeResource AccentButtonStyle}" Content="应用到两个按键" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 按键映射与快速绑宏 -->
                        <Border x:Name="MacroAndButtonsCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="按键映射与快速绑宏" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="MacroNoteText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="ButtonBindingsSection" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="板载按键重映射" FontSize="13" FontWeight="SemiBold" />
                                    <StackPanel x:Name="ButtonBindingsPanel" Spacing="8" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ComboBox x:Name="QuickMacroCombo" Header="软件宏" Width="220" />
                                    <ComboBox x:Name="QuickMacroBtnCombo" Header="触发鼠标键" Width="180" />
                                    <Button x:Name="QuickEnrollMacroBtn" Style="{ThemeResource AccentButtonStyle}"
                                            Content="绑定到本设备" VerticalAlignment="Bottom" />
                                    <Button x:Name="OpenMacroHubBtn" Content="打开鼠标宏中心" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <StackPanel x:Name="DeviceMacroBindingsSummary" Spacing="6" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ TAB 4: 高级 ============ -->
                    <StackPanel x:Name="PanelAdvanced" Spacing="14" Visibility="Collapsed">
                        <Border x:Name="AdvancedCard" Visibility="Collapsed"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel Spacing="16">
                                <TextBlock Text="静默高度、防抖与电源管理" FontSize="17" FontWeight="SemiBold" />

                                <!-- LOD 档位按钮 + 滑动条 -->
                                <StackPanel x:Name="LodSection" Spacing="10" Visibility="Collapsed">
                                    <TextBlock Text="静默高度 (LOD)" FontSize="14" FontWeight="SemiBold" />
                                    <controls:ResponsiveWrapPanel x:Name="LodButtonsPanel" Spacing="8" LineSpacing="6" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="细腻高度调节:" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Slider Grid.Column="1" x:Name="LodSlider"
                                                Maximum="10" Minimum="0" StepFrequency="1" />
                                        <TextBlock Grid.Column="2" x:Name="LodSliderValueText" Text="-"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="88" />
                                    </Grid>
                                </StackPanel>

                                <!-- 非对称抬起/着陆高度 -->
                                <StackPanel x:Name="AsymLodSection" Spacing="10" Visibility="Collapsed">
                                    <ToggleSwitch x:Name="AsymLodSwitch" Header="启用非对称抬起/着陆高度 (Razer 0.1~2.5mm)" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="抬起高度:" VerticalAlignment="Center" MinWidth="70" />
                                        <Slider Grid.Column="1" x:Name="AsymLiftSlider"
                                                Maximum="26" Minimum="0" StepFrequency="1" />
                                        <TextBlock Grid.Column="2" x:Name="AsymLiftText" Text="-" VerticalAlignment="Center" MinWidth="54" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="着陆高度:" VerticalAlignment="Center" MinWidth="70" />
                                        <Slider Grid.Column="1" x:Name="AsymLandSlider"
                                                Maximum="25" Minimum="0" StepFrequency="1" />
                                        <TextBlock Grid.Column="2" x:Name="AsymLandText" Text="-" VerticalAlignment="Center" MinWidth="54" />
                                    </Grid>
                                    <Button x:Name="ApplyAsymLodBtn" Content="应用非对称高度" HorizontalAlignment="Left" />
                                </StackPanel>

                                <!-- 按键防抖 -->
                                <Grid x:Name="DebounceSection" ColumnSpacing="12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="按键防抖延迟:" VerticalAlignment="Center" MinWidth="92" />
                                    <Slider Grid.Column="1" x:Name="DebounceSlider"
                                            Maximum="30" Minimum="0" StepFrequency="1" />
                                    <TextBlock Grid.Column="2" x:Name="DebounceValueText" Text="0 ms" VerticalAlignment="Center" MinWidth="54" />
                                </Grid>

                                <!-- 传感器角度校准 -->
                                <Grid x:Name="AngleTuningSection" ColumnSpacing="12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="传感器角度校准:" VerticalAlignment="Center" MinWidth="104" />
                                    <Slider Grid.Column="1" x:Name="AngleSlider"
                                            Maximum="30" Minimum="-30" StepFrequency="1" />
                                    <TextBlock Grid.Column="2" x:Name="AngleValueText" Text="0°" VerticalAlignment="Center" MinWidth="54" />
                                </Grid>

                                <!-- 离散休眠档位 -->
                                <StackPanel x:Name="DiscreteSleepSection" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="休眠时间档位" FontSize="13" FontWeight="SemiBold" />
                                    <controls:ResponsiveWrapPanel x:Name="DiscreteSleepPanel" Spacing="8" LineSpacing="6" />
                                </StackPanel>

                                <!-- 连续休眠时间 -->
                                <Grid x:Name="SleepSection" ColumnSpacing="12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="无操作休眠:" VerticalAlignment="Center" MinWidth="92" />
                                    <Slider Grid.Column="1" x:Name="SleepSlider"
                                            Maximum="30" Minimum="0" StepFrequency="1" />
                                    <TextBlock Grid.Column="2" x:Name="SleepValueText" Text="5 min" VerticalAlignment="Center" MinWidth="60" />
                                </Grid>

                                <!-- 硬件低电量告警阈值 -->
                                <Grid x:Name="LowBatWarnSection" ColumnSpacing="12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="硬件低电告警:" VerticalAlignment="Center" MinWidth="92" />
                                    <Slider Grid.Column="1" x:Name="LowBatSlider"
                                            Maximum="50" Minimum="0" StepFrequency="5" />
                                    <TextBlock Grid.Column="2" x:Name="LowBatValueText" Text="15%" VerticalAlignment="Center" MinWidth="54" />
                                </Grid>

                                <Button x:Name="ApplyPowerBtn" Style="{ThemeResource AccentButtonStyle}" Content="应用电源与省电参数" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

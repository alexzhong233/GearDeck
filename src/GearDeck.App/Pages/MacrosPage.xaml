<Page
    x:Class="GearDeck.App.Pages.MacrosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GearDeck.App.Controls">
    <ScrollViewer Padding="24,20">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="鼠标宏中心" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="统一创建与录制键盘/鼠标宏，并按设备能力烧录进硬件闪存、写入板载改键或绑定驱动级侧键触发"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel x:Name="ViewSwitchSlot" Grid.Column="1" VerticalAlignment="Center" />
            </Grid>

            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="True" />

            <InfoBar x:Name="AdminPrivilegeBanner"
                     IsOpen="False" IsClosable="True" Severity="Warning"
                     Title="当前以普通用户权限运行（UIPI 限制）"
                     Message="若需要在管理员权限运行的游戏/全屏程序（如 CS2、Valorant、Apex 等）中触发软件侧键宏，请使用管理员权限重启 GearDeck。">
                <InfoBar.ActionButton>
                    <Button Content="以管理员身份重启 GearDeck" Click="OnRestartAsAdmin" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- 自适应双栏 / 窄屏单栏布局 -->
            <Grid x:Name="WorkspaceGrid" ColumnSpacing="16" RowSpacing="16">
                <!-- 左/上：宏预设库 -->
                <Border x:Name="LibraryPane"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="宏预设库" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="+ 新建宏" Style="{ThemeResource AccentButtonStyle}" Click="OnNewMacro" />
                        </Grid>
                        <controls:ResponsiveItemsHost x:Name="MacroLibraryHost" MinCardWidth="240" Gap="10" />
                    </StackPanel>
                </Border>

                <!-- 右/下：宏录制编辑器 + 录入到设备 -->
                <StackPanel x:Name="EditorPane" Spacing="16">
                    <!-- 编辑器卡片 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="EditorTitleText" Text="宏动作录制与编辑" FontSize="18" FontWeight="SemiBold" />

                            <controls:ResponsiveWrapPanel Spacing="10" LineSpacing="10">
                                <TextBox x:Name="MacroNameBox" Header="宏名称" Width="210" />
                                <ComboBox x:Name="MacroLoopCombo" Header="触发方式（雷云模式）" Width="245" SelectionChanged="OnMacroPropertyChanged">
                                    <ComboBoxItem Tag="PlayOnce" Content="单次触发（按下播放 1 次）" />
                                    <ComboBoxItem Tag="WhileHeld" Content="按住触发（按住循环，松开即停）" />
                                    <ComboBoxItem Tag="ToggleUntilKey" Content="切换触发（再按或 Esc 停止）" />
                                    <ComboBoxItem Tag="RepeatCount" Content="指定次数（按下循环 N 次）" />
                                </ComboBox>
                                <NumberBox x:Name="MacroRepeatBox" Header="重复次数" Width="130" Maximum="99" Minimum="1"
                                           Value="1" SpinButtonPlacementMode="Compact" ValueChanged="OnMacroRepeatChanged" />
                            </controls:ResponsiveWrapPanel>

                            <controls:ResponsiveWrapPanel Spacing="8" LineSpacing="8">
                                <ToggleButton x:Name="RecordMacroBtn" Content="开始录制键盘按键与鼠标点击"
                                              Checked="OnRecordStart" Unchecked="OnRecordStop" />
                                <Button Content="+ 鼠标左键点击" Click="OnAddLeftClickStep" />
                                <Button Content="+ 鼠标右键点击" Click="OnAddRightClickStep" />
                                <Button Content="+ 鼠标中键点击" Click="OnAddMiddleClickStep" />
                                <Button Content="清空步骤" Click="OnClearMacroSteps" />
                            </controls:ResponsiveWrapPanel>

                            <TextBox x:Name="RecordFocusTrap" Visibility="Collapsed" IsReadOnly="True"
                                     PlaceholderText="录制中：请在此框内直接按键盘或点击鼠标左右/中键以记录顺序与真实延迟..."
                                     PreviewKeyDown="OnRecorderKeyDown" PreviewKeyUp="OnRecorderKeyUp"
                                     PointerPressed="OnRecorderPointerPressed" PointerReleased="OnRecorderPointerReleased" />

                            <controls:ResponsiveWrapPanel Spacing="8" LineSpacing="8">
                                <ComboBox x:Name="ManualKeyCombo" Header="手动选键" Width="180" />
                                <NumberBox x:Name="ManualDelayBox" Header="步间延迟 (ms)" Width="130" Maximum="5000" Minimum="5"
                                           Value="25" SpinButtonPlacementMode="Compact" />
                                <Button Content="+ 添加完整点击" VerticalAlignment="Bottom" Click="OnAddManualKeyClick" />
                            </controls:ResponsiveWrapPanel>

                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12" MaxHeight="260">
                                <ScrollViewer>
                                    <StackPanel x:Name="MacroStepsPanel" Spacing="4" />
                                </ScrollViewer>
                            </Border>

                            <controls:ResponsiveWrapPanel Spacing="10" LineSpacing="8">
                                <Button Content="保存宏到库" Style="{ThemeResource AccentButtonStyle}" Click="OnSaveMacro" />
                                <Button Content="本地测试回放" Click="OnTestPlayMacro" />
                                <Button Content="停止回放" Click="OnStopPlayMacro" />
                            </controls:ResponsiveWrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 录入到设备卡片 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="录入宏到鼠标设备" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="优先写入支持 320B 闪存/按键重映射的鼠标硬件内存；多步复合宏在非闪存固件下可自动绑定为驱动级侧键触发。"
                                           FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <controls:ResponsiveWrapPanel Spacing="10" LineSpacing="10">
                                <ComboBox x:Name="TargetMouseCombo" Header="目标鼠标设备" MinWidth="250" SelectionChanged="OnTargetMouseChanged" />
                                <ComboBox x:Name="TargetButtonCombo" Header="触发按键" MinWidth="200" SelectionChanged="OnTargetButtonChanged" />
                                <NumberBox x:Name="EnrollSlotBox" Header="硬件宏槽位 (0~7)" Width="150" Maximum="7" Minimum="0"
                                           Value="0" SpinButtonPlacementMode="Compact" />
                            </controls:ResponsiveWrapPanel>

                            <TextBlock x:Name="EnrollCapabilityText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <controls:ResponsiveWrapPanel Spacing="10" LineSpacing="8">
                                <Button x:Name="EnrollBtn" Content="将当前宏录入到选定设备"
                                        Style="{ThemeResource AccentButtonStyle}" Click="OnEnrollMacroToDevice" />
                                <Button Content="探测该鼠标硬件支持能力" Click="OnProbeTargetMouse" />
                                <Button Content="解除该设备此键宏绑定" Click="OnUnbindSelectedDeviceButton" />
                            </controls:ResponsiveWrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

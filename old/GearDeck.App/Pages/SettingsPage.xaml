<Page
    x:Class="GearDeck.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GearDeck.App.Controls">
    <ScrollViewer Padding="24,20">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="版本更新与 GitHub 镜像、托盘常驻、Windows 原生通知、Debug 诊断模式与独立低电量阈值"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 版本更新与 GitHub 镜像站 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="软件版本、检查更新与 GitHub 镜像站" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="支持一键检测 GitHub 新版本、自动校验 SHA-256 并热替换重启升级；可配置自定义 GitHub 镜像加速检测与下载。"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Center" Padding="10,4" CornerRadius="12"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <TextBlock x:Name="CurrentVersionBadgeText" Text="当前版本 v1.0.0" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <ToggleSwitch x:Name="AutoCheckUpdateSwitch"
                                  Header="启动时自动检查更新"
                                  OnContent="启动后静默检查新版本"
                                  OffContent="仅手动点击检查"
                                  Toggled="OnAutoCheckUpdateToggled" />

                    <TextBox x:Name="GitHubMirrorBox"
                             Header="自定义 GitHub 镜像站（留空直连 GitHub；支持前缀如 https://ghfast.top/ 或 {url} 模板）"
                             PlaceholderText="例如：https://ghfast.top/ 或 https://gh-proxy.com/ 或 https://example.com/{url}" />

                    <controls:ResponsiveWrapPanel Spacing="8" LineSpacing="8">
                        <Button Content="直连 GitHub（清空）" Click="OnMirrorPresetClear" />
                        <Button Content="填入 ghfast.top" Click="OnMirrorPresetGhfast" />
                        <Button Content="填入 gh-proxy.com" Click="OnMirrorPresetGhProxy" />
                        <Button Content="保存镜像设置" Click="OnSaveMirrorOnly" />
                    </controls:ResponsiveWrapPanel>

                    <controls:ResponsiveWrapPanel Spacing="10" LineSpacing="8">
                        <Button x:Name="CheckUpdateBtn" Content="立即检查更新"
                                Style="{ThemeResource AccentButtonStyle}" Click="OnCheckUpdateClick" />
                        <Button x:Name="DownloadUpdateBtn" Content="立即下载并更新重启"
                                Style="{ThemeResource AccentButtonStyle}" Visibility="Collapsed" Click="OnDownloadUpdateClick" />
                        <Button Content="打开 GitHub Releases" Click="OnOpenGitHubReleasesClick" />
                    </controls:ResponsiveWrapPanel>

                    <ProgressBar x:Name="UpdateProgressBar" Maximum="100" Minimum="0" Value="0" Visibility="Collapsed" />

                    <TextBlock x:Name="UpdateStatusText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border x:Name="ReleaseNotesCard" Visibility="Collapsed" Padding="12" CornerRadius="6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="ReleaseNotesTitleText" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReleaseNotesText" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="14">
                    <controls:ResponsiveWrapPanel Spacing="24" LineSpacing="12">
                        <ToggleSwitch x:Name="CloseToTraySwitch"
                                      Header="关闭主窗口后常驻系统托盘"
                                      OnContent="最小化到托盘继续运行"
                                      OffContent="直接退出整个程序"
                                      Toggled="OnCloseToTrayToggled" />
                        <ToggleSwitch x:Name="StartupSwitch"
                                      Header="Windows 开机自动启动"
                                      OnContent="开机静默常驻托盘"
                                      OffContent="手动启动"
                                      Toggled="OnStartupToggled" />
                        <ToggleSwitch x:Name="NotifySwitch"
                                      Header="配置切换 Windows 原生通知"
                                      OnContent="开启切换通知"
                                      OffContent="关闭通知"
                                      Toggled="OnNotifyToggled" />
                        <ToggleSwitch x:Name="DebugSwitch"
                                      Header="Debug 调试模式（显示「诊断」栏）"
                                      OnContent="已开启（左侧显示「诊断」页）"
                                      OffContent="已隐藏诊断页"
                                      Toggled="OnDebugToggled" />
                        <ToggleSwitch x:Name="GlobalLowBatNotifySwitch"
                                      Header="全局设备低电量通知提醒（默认低于 20%，单设备可在设备总览页单独调整）"
                                      OnContent="开启低电量通知提醒"
                                      OffContent="全局暂停低电量提醒"
                                      Toggled="OnGlobalLowBatNotifyToggled" />
                    </controls:ResponsiveWrapPanel>

                    <controls:ResponsiveWrapPanel Spacing="16" LineSpacing="10">
                        <NumberBox x:Name="IntervalBox" Header="HID 设备轮询间隔（秒）" Maximum="300" Minimum="5" SmallChange="5" LargeChange="15" Width="210" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="GamePollIntervalBox" Header="前台游戏监测间隔（毫秒）" Maximum="5000" Minimum="250" SmallChange="100" LargeChange="250" Width="220" SpinButtonPlacementMode="Compact" />
                    </controls:ResponsiveWrapPanel>
                    <TextBlock Text="推荐默认：HID 15 秒（平衡电量与唤醒同步）；前台游戏 1000 毫秒（足够灵敏且几乎零 CPU 占用），点击保存后立即生效。"
                               FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <controls:ResponsiveWrapPanel Spacing="12" LineSpacing="8">
                        <Button Content="保存通用设置" Style="{ThemeResource AccentButtonStyle}" Click="OnSave" />
                        <TextBlock x:Name="SavedHintText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </controls:ResponsiveWrapPanel>
                </StackPanel>
            </Border>

            <!-- 外置设备图片规则与云端自动拉取 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="外置设备图片规则与云端自动拉取" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="支持编辑本地 device-images.json 或挂载免费远程 JSON 清单，无需重编代码即可为新插上的设备自动匹配下载图片。"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBox x:Name="CloudManifestUrlBox" Header="自定义云端规则 / 图库 JSON URL（可选，支持 GitHub / jsDelivr 直链）"
                             PlaceholderText="例如：https://cdn.jsdelivr.net/gh/用户名/仓库@main/device-images.json" />
                    <controls:ResponsiveWrapPanel Spacing="10" LineSpacing="8">
                        <Button Content="打开本地规则 (device-images.json)" Click="OnOpenLocalImageManifest" />
                        <Button x:Name="SyncCloudImagesBtn" Content="保存并自动同步云端图片"
                                Style="{ThemeResource AccentButtonStyle}" Click="OnSyncCloudImages" />
                        <TextBlock x:Name="ImageSyncHintText" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </controls:ResponsiveWrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

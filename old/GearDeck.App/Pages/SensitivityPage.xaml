<Page
    x:Class="GearDeck.App.Pages.SensitivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GearDeck.App.Controls">

    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,18,24,28" Spacing="14">

            <!-- 顶部标题栏 -->
            <StackPanel Spacing="4">
                <TextBlock Text="跨游戏灵敏度换算" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="选择基准游戏并输入 FOV 与灵敏度，点击下方任意热门游戏卡片即时换算并查看具体改法；展开高级设置可调整 DPI 与分辨率/拉伸。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <InfoBar x:Name="PageInfoBar" IsOpen="False" IsClosable="True" />
            </StackPanel>

            <!-- 主工作区：左侧基准设置 + 右侧目标换算结果 -->
            <Grid x:Name="WorkspaceGrid" ColumnSpacing="14" RowSpacing="14" SizeChanged="OnWorkspaceSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BaseColDef" Width="370" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 左侧：基准游戏设置 -->
                <Border x:Name="BaseCard" Grid.Row="0" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="基准游戏设置" FontSize="16" FontWeight="SemiBold" />

                        <ComboBox x:Name="BaseGameCombo" Header="基准游戏" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnBaseGameChanged" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BaseSensBox" Grid.Column="0" Header="基准灵敏度"
                                     TextChanged="OnNumericInputChanged" />
                            <Button Grid.Column="1" Content="÷2" VerticalAlignment="Bottom"
                                    Padding="10,6" Click="OnBaseSensHalfClick" />
                            <Button Grid.Column="2" Content="×2" VerticalAlignment="Bottom"
                                    Padding="10,6" Click="OnBaseSensDoubleClick" />
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BaseFovBox" Grid.Column="0" Header="基准 FOV"
                                     TextChanged="OnNumericInputChanged" />
                            <Button x:Name="BaseFovResetBtn" Grid.Column="1" Content="默认" VerticalAlignment="Bottom"
                                    Padding="10,6" Click="OnBaseFovResetClick" />
                        </Grid>
                        <TextBlock x:Name="BaseFovMetaText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <TextBlock Text="转换算法" FontSize="14" FontWeight="SemiBold" />
                        <controls:ResponsiveWrapPanel Spacing="6" LineSpacing="6">
                            <Button x:Name="MethodCm360Btn" Tag="Cm360" Content="360° 等距" Click="OnMethodClick" />
                            <Button x:Name="MethodMdv0Btn" Tag="Mdv0" Content="FOV 焦距缩放 (MDV 0%)" Click="OnMethodClick" />
                            <Button x:Name="MethodMdh100Btn" Tag="Mdh100" Content="水平边缘对齐 (MDH 100%)" Click="OnMethodClick" />
                        </controls:ResponsiveWrapPanel>
                        <TextBlock x:Name="MethodDescText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 右侧：目标游戏转换结果与修改指南 -->
                <Border x:Name="TargetCard" Grid.Row="0" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="TargetGameTitleText" FontSize="20" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border VerticalAlignment="Center" CornerRadius="6" Padding="6,2"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock x:Name="TargetTagBadgeText" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TargetFovMetaText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <TextBox x:Name="TargetFovBox" Width="104" Header="目标 FOV"
                                         TextChanged="OnNumericInputChanged" />
                                <Button x:Name="TargetFovResetBtn" Content="默认" VerticalAlignment="Bottom"
                                        Padding="10,6" Click="OnTargetFovResetClick" />
                                <Button Content="互换基准/目标" VerticalAlignment="Bottom"
                                        Padding="10,6" Click="OnSwapGamesClick" />
                            </StackPanel>
                        </Grid>

                        <!-- 结果高亮区 -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="10" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                                    <TextBlock x:Name="PrimaryResultText" FontSize="34" FontWeight="Bold" />
                                    <TextBlock x:Name="PrimaryMethodTagText" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <controls:ResponsiveWrapPanel Spacing="8" LineSpacing="6">
                                    <Button x:Name="CopySensBtn" Content="复制灵敏度"
                                            Style="{ThemeResource AccentButtonStyle}" Click="OnCopySensClick" />
                                    <StackPanel x:Name="ConfigSnippetPanel" Spacing="6" Visibility="Collapsed">
                                        <TextBlock x:Name="ConfigSnippetText" FontFamily="Consolas" FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <Button Content="复制命令" Padding="10,5" Click="OnCopySnippetClick" />
                                    </StackPanel>
                                </controls:ResponsiveWrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 四项对比指标 -->
                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Padding="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="360° 等距 vs 焦距缩放" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="MetricCompareText" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" CornerRadius="8" Padding="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="物理转身 cm/360° &amp; eDPI" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="MetricCm360Text" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" CornerRadius="8" Padding="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="实际视野 HFOV / VFOV" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="MetricFovText" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" CornerRadius="8" Padding="12"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="像素步进 &amp; 2K 跑满手速" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="MetricPixelSpeedText" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 该游戏怎么改 -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="该游戏怎么改" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="GuideSettingPathText" TextWrapping="Wrap" />
                            <TextBlock x:Name="GuideConfigTipText" TextWrapping="Wrap" />
                            <TextBlock x:Name="GuideAdsTipText" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="DynamicWarningsPanel" Spacing="6" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 高级功能折叠面板：DPI 与分辨率 -->
            <Expander x:Name="AdvancedExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                <Expander.Header>
                    <TextBlock x:Name="AdvancedSummaryText" FontSize="14" FontWeight="SemiBold"
                               Text="高级功能：DPI 与 分辨率（当前 800 DPI · 1920×1080 16:9）" />
                </Expander.Header>
                <controls:ResponsiveWrapPanel Spacing="16" LineSpacing="12">
                    <StackPanel Spacing="10" MinWidth="320">
                        <TextBlock Text="DPI 设置" FontSize="15" FontWeight="SemiBold" />
                        <controls:ResponsiveWrapPanel Spacing="6" LineSpacing="6">
                            <TextBox x:Name="BaseDpiBox" Width="110" Header="基准鼠标 DPI"
                                     TextChanged="OnNumericInputChanged" />
                            <Button Content="400" Tag="400" VerticalAlignment="Bottom" Padding="10,6"
                                    Click="OnBaseDpiPresetClick" />
                            <Button Content="800" Tag="800" VerticalAlignment="Bottom" Padding="10,6"
                                    Click="OnBaseDpiPresetClick" />
                            <Button Content="1600" Tag="1600" VerticalAlignment="Bottom" Padding="10,6"
                                    Click="OnBaseDpiPresetClick" />
                            <Button Content="3200" Tag="3200" VerticalAlignment="Bottom" Padding="10,6"
                                    Click="OnBaseDpiPresetClick" />
                        </controls:ResponsiveWrapPanel>
                        <Button x:Name="ReadMouseDpiBtn" Content="读取当前鼠标 DPI" HorizontalAlignment="Left"
                                Padding="10,6" Click="OnReadMouseDpiClick" />
                        <CheckBox x:Name="SameDpiCheck" Content="目标游戏使用相同 DPI"
                                  Checked="OnAdvancedCheckChanged" Unchecked="OnAdvancedCheckChanged" />
                        <StackPanel x:Name="TargetDpiPanel" Spacing="8" Visibility="Collapsed">
                            <controls:ResponsiveWrapPanel Spacing="6" LineSpacing="6">
                                <TextBox x:Name="TargetDpiBox" Width="110" Header="目标鼠标 DPI"
                                         TextChanged="OnNumericInputChanged" />
                                <Button Content="400" Tag="400" VerticalAlignment="Bottom" Padding="10,6"
                                        Click="OnTargetDpiPresetClick" />
                                <Button Content="800" Tag="800" VerticalAlignment="Bottom" Padding="10,6"
                                        Click="OnTargetDpiPresetClick" />
                                <Button Content="1600" Tag="1600" VerticalAlignment="Bottom" Padding="10,6"
                                        Click="OnTargetDpiPresetClick" />
                                <Button Content="3200" Tag="3200" VerticalAlignment="Bottom" Padding="10,6"
                                        Click="OnTargetDpiPresetClick" />
                            </controls:ResponsiveWrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="10" MinWidth="320">
                        <TextBlock Text="分辨率与比例设置" FontSize="15" FontWeight="SemiBold" />
                        <controls:ResponsiveWrapPanel Spacing="8" LineSpacing="8">
                            <ComboBox x:Name="BaseResPresetCombo" Header="基准分辨率预设" Width="230"
                                      SelectionChanged="OnBaseResPresetChanged" />
                            <TextBox x:Name="BaseWidthBox" Width="90" Header="宽"
                                     TextChanged="OnNumericInputChanged" />
                            <TextBox x:Name="BaseHeightBox" Width="90" Header="高"
                                     TextChanged="OnNumericInputChanged" />
                        </controls:ResponsiveWrapPanel>
                        <CheckBox x:Name="BaseStretchCheck" Content="4:3 拉伸到 16:9 满屏"
                                  Checked="OnAdvancedCheckChanged" Unchecked="OnAdvancedCheckChanged" />
                        <CheckBox x:Name="SameResCheck" Content="目标游戏使用相同分辨率"
                                  Checked="OnAdvancedCheckChanged" Unchecked="OnAdvancedCheckChanged" />
                        <StackPanel x:Name="TargetResPanel" Spacing="8" Visibility="Collapsed">
                            <controls:ResponsiveWrapPanel Spacing="8" LineSpacing="8">
                                <ComboBox x:Name="TargetResPresetCombo" Header="目标分辨率预设" Width="230"
                                          SelectionChanged="OnTargetResPresetChanged" />
                                <TextBox x:Name="TargetWidthBox" Width="90" Header="宽"
                                         TextChanged="OnNumericInputChanged" />
                                <TextBox x:Name="TargetHeightBox" Width="90" Header="高"
                                         TextChanged="OnNumericInputChanged" />
                            </controls:ResponsiveWrapPanel>
                            <CheckBox x:Name="TargetStretchCheck" Content="4:3 拉伸到 16:9 满屏"
                                      Checked="OnAdvancedCheckChanged" Unchecked="OnAdvancedCheckChanged" />
                        </StackPanel>
                    </StackPanel>
                </controls:ResponsiveWrapPanel>
            </Expander>

            <!-- 热门游戏卡片墙 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="12">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="热门游戏一览（点击卡片直接换算）" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="卡片上显示按当前基准、DPI 与分辨率实时预估的目标灵敏度；点击卡片换算，点「设为基准」交换基准。"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBox x:Name="GameSearchBox" Grid.Column="1" Width="220"
                                     PlaceholderText="搜索游戏或引擎..." TextChanged="OnGameFilterChanged" />
                        </Grid>
                        <controls:ResponsiveWrapPanel x:Name="CategoryFilterPanel" Grid.Row="1"
                                                      Spacing="6" LineSpacing="6">
                            <Button Content="全部" Tag="全部" Padding="10,5" Click="OnCategoryFilterClick" />
                            <Button Content="战术射击" Tag="战术射击" Padding="10,5" Click="OnCategoryFilterClick" />
                            <Button Content="大逃杀 / 搜打撤" Tag="大逃杀 / 搜打撤" Padding="10,5" Click="OnCategoryFilterClick" />
                            <Button Content="英雄射击" Tag="英雄射击" Padding="10,5" Click="OnCategoryFilterClick" />
                            <Button Content="练枪 / 拟真" Tag="练枪 / 拟真" Padding="10,5" Click="OnCategoryFilterClick" />
                        </controls:ResponsiveWrapPanel>
                    </Grid>
                    <controls:ResponsiveItemsHost x:Name="GameCardsHost" MinCardWidth="235" Gap="10" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

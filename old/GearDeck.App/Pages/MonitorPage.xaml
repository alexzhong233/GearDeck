<Page
    x:Class="GearDeck.App.Pages.MonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GearDeck.App.Controls">
    <ScrollViewer Padding="24,20">
        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="系统监控" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="支持 12 项实时硬件与网络指标；在这里统一配置任务栏上下行与鼠标悬停悬浮窗显示项"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="14">
                    <ToggleSwitch x:Name="MonitorSwitch" Header="在任务栏贴片中显示系统监控" Toggled="OnToggle" />
                    <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:ResponsiveWrapPanel Spacing="14" LineSpacing="10">
                        <ComboBox x:Name="TopMetricBox" Header="任务栏上行显示" MinWidth="210" SelectionChanged="OnTaskbarMetricChanged" />
                        <ComboBox x:Name="BottomMetricBox" Header="任务栏下行显示" MinWidth="210" SelectionChanged="OnTaskbarMetricChanged" />
                    </controls:ResponsiveWrapPanel>
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="悬浮窗监控项（勾选即在鼠标悬停悬浮窗中显示）" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="下方卡片或列表均实时预览本机每秒采集读数" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <controls:ResponsiveWrapPanel Grid.Column="1" Spacing="8" LineSpacing="6" VerticalAlignment="Center">
                    <Button Content="全选" Click="OnSelectAll" />
                    <Button Content="仅核心" Click="OnSelectCore" />
                    <Button Content="恢复默认" Click="OnResetDefaults" />
                    <StackPanel x:Name="ViewSwitchSlot" />
                </controls:ResponsiveWrapPanel>
            </Grid>

            <controls:ResponsiveItemsHost x:Name="FlyoutMetricsHost" MinCardWidth="260" Gap="10" />
        </StackPanel>
    </ScrollViewer>
</Page>
